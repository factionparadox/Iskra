# Iskra's package repository: everything Iskra's CI builds and publishes, ready-made, so that
# nothing on Iskra ever has to be compiled on the laptop. Built in this order, each in a clean
# Slackware -current system, by build/build-packages; published by build/make-repo.
#
# One package a line:  NAME  FROM
#   iskra:NAME      Iskra's own SlackBuild, in packages/NAME/
#   ponce:PATH      Ponce's SlackBuild for -current (github.com/Ponce/slackbuilds, branch current),
#                   optionally with  patch=packages/NAME/x.patch. What it REQUIRES is installed from
#                   the ready-made repositories, or built here first from Ponce's too.
#   arch:NAME       built by sparkpkg from Arch Linux's own recipe
#   aur:NAME        built by sparkpkg from the AUR's recipe
# Everything else Iskra installs comes ready-made from Slackware, AlienBOB or conraid.

# sparkpkg's own tools
fakeroot                ponce:system/fakeroot
slpkg                   ponce:system/slpkg  patch=packages/slpkg/iskra.patch

# the desktop: Mango (Wayland), kitty, waybar, wofi; greetd + gtkgreet to log in
scenefx                 iskra:scenefx      # Mango's blur, shadows and rounded corners
mango                   iskra:mango        # the compositor: tags, Niri-style scroller
kitty                   iskra:kitty        # kitty's own ready-made build
waybar                  ponce:desktop/waybar
wofi                    ponce:desktop/wofi
dunst                   ponce:desktop/dunst
swaylock                ponce:desktop/swaylock
swayidle                ponce:desktop/swayidle
swaybg                  ponce:desktop/swaybg
wlsunset                ponce:desktop/wlsunset
grim                    ponce:desktop/grim
slurp                   ponce:desktop/slurp
swappy                  ponce:graphics/swappy
wl-clipboard            ponce:misc/wl-clipboard
playerctl               ponce:multimedia/playerctl
xdg-desktop-portal-wlr  ponce:system/xdg-desktop-portal-wlr
brightnessctl           ponce:system/brightnessctl
greetd                  ponce:system/greetd
cage                    iskra:cage         # the login screen runs in it
gtkgreet                iskra:gtkgreet     # the login screen
plan9port               ponce:system/plan9port
font-go                 iskra:font-go
font-ipaex              iskra:font-ipaex
networkmanager-dmenu    arch:networkmanager-dmenu
# later (doesn't build yet): udiskie                 arch:udiskie
pulsemixer              ponce:audio/pulsemixer
# later (doesn't build yet): bluetuith               aur:bluetuith
# later (doesn't build yet): chrony                  ponce:network/chrony

# the 13 Pro: power, temperature and Framework's own tool
thermald                ponce:system/thermald
# later (doesn't build yet): intel-lpmd              arch:intel-lpmd
framework-tool          iskra:framework-tool

# programs
freetube                ponce:multimedia/freetube
# later (doesn't build yet): webcord                 aur:webcord-bin
# later (doesn't build yet): proton-vpn-gtk-app      arch:proton-vpn-gtk-app
yt-dlp                  ponce:network/yt-dlp
ani-cli                 iskra:ani-cli

# Russian: dictionaries, the tutor's engine and voices
hunspell-en             ponce:office/hunspell-en
hunspell-russian-aot    ponce:office/hunspell-russian-aot
llama.cpp               iskra:llama.cpp
piper-tts               iskra:piper-tts
kiwix-tools             iskra:kiwix-tools

# Iskra itself
sparkpkg                iskra:sparkpkg
iskra-desktop           iskra:iskra-desktop
iskra-learn             iskra:iskra-learn
iskra-russian           iskra:iskra-russian
iskra                   iskra:iskra
