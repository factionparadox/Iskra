#!/bin/bash
# llama.cpp.SlackBuild: Iskra's SlackBuild for llama.cpp. Run in this folder, as root.
# llama.cpp's own ready-made Linux build (release b11960, Vulkan), unpacked: nothing compiled.
# It carries a CPU part for every x86-64 processor and picks the best for this one when it
# starts; Vulkan uses the Intel graphics. Its programs find their libraries beside them
# ($ORIGIN), so it lives in /usr/lib64/llama.cpp, with its programs linked into /usr/bin.
PRGNAM=llama.cpp
. ../lib.sh
cd $TMP; rm -rf llama-b11960; tar xf $CWD/llama-b11960-bin-ubuntu-vulkan-x64.tar.gz
install -d $PKG/usr/lib64 $PKG/usr/bin $PKG/usr/doc/$PRGNAM-$VERSION
cp -a llama-b11960 $PKG/usr/lib64/llama.cpp
chown -R root:root $PKG/usr/lib64/llama.cpp
mv $PKG/usr/lib64/llama.cpp/LICENSE* $PKG/usr/doc/$PRGNAM-$VERSION/ 2>/dev/null || true
for f in $PKG/usr/lib64/llama.cpp/llama*; do
  [ -f "$f" ] && [ -x "$f" ] && [[ $f != *.so* ]] && ln -s ../lib64/llama.cpp/${f##*/} $PKG/usr/bin/${f##*/}
done
# llama.cpp's own build: left exactly as made (not stripped)
cd $PKG; slackdesc
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
