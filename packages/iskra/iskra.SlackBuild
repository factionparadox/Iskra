#!/bin/bash
# iskra.SlackBuild: Iskra's SlackBuild for iskra, made from this repository's own files.
# Run in this folder, as root (build/build-packages provides iskra-source.tar.gz).
PRGNAM=iskra
. ../lib.sh
mkdir -p $PKG/usr/share/iskra $PKG/install
echo "Искра / Iskra $VERSION" > $PKG/usr/share/iskra/version
cat > $PKG/usr/share/iskra/os-release <<OSRELEASE
NAME="Iskra"
VERSION="$VERSION"
ID=iskra
ID_LIKE=slackware
VERSION_ID=$VERSION
PRETTY_NAME="Iskra $VERSION (Slackware -current)"
ANSI_COLOR="0;31"
HOME_URL="https://github.com/factionparadox/iskra"
BUG_REPORT_URL="https://github.com/factionparadox/iskra/issues"
VERSION_CODENAME=iskra
OSRELEASE
cp $CWD/doinst.sh $PKG/install/doinst.sh
chown -R root:root $PKG
cd $PKG; slackdesc
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-noarch-$BUILD$TAG.$PKGTYPE"
