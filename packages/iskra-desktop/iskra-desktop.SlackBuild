#!/bin/bash
# iskra-desktop.SlackBuild: Iskra's SlackBuild for iskra-desktop, made from this repository's own files.
# Run in this folder, as root (build/build-packages provides iskra-source.tar.gz).
PRGNAM=iskra-desktop
. ../lib.sh
cd $TMP; rm -rf iskra-source; mkdir iskra-source
tar xf $CWD/iskra-source.tar.gz -C iskra-source
cd iskra-source/desktop/root
cp -a . $PKG/
mkdir -p $PKG/install
# sparkpkg's files are its own package
rm -rf $PKG/usr/bin/sparkpkg $PKG/usr/lib/sparkpkg $PKG/usr/share/sparkpkg $PKG/etc/slpkg \
       $PKG/etc/ld.so.conf.d/sparkpkg.conf $PKG/etc/profile.d/sparkpkg.sh
rmdir $PKG/etc/ld.so.conf.d 2>/dev/null || true
chmod 440 $PKG/etc/sudoers.d/iskra
cp $CWD/doinst.sh $PKG/install/doinst.sh
( cd $PKG && find etc -type f ) | while read -r f; do
  mv "$PKG/$f" "$PKG/$f.new"
  echo "config $f.new" >> $PKG/install/doinst.sh
done
mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION; cp ../../LICENSE $PKG/usr/doc/$PRGNAM-$VERSION/
chown -R root:root $PKG
cd $PKG; slackdesc
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-noarch-$BUILD$TAG.$PKGTYPE"
