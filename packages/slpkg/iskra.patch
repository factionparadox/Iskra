# Iskra's changes to slpkg:
# 1. GPG_KEY_IMPORT = false in /etc/slpkg/slpkg.toml leaves signing keys to sparkpkg, which imports
#    only the keys whose fingerprints Iskra pins. Stock slpkg fetches whatever key each mirror offers
#    on every update, and for git repositories (Ponce) builds an address that fails.
# 2. With no terminal (a script, CI, a pipe), the package picker chooses as Enter would, instead
#    of crashing (termios.error: Inappropriate ioctl for device).
# 3. A package whose signature fails is never installed. Stock slpkg asks whether to continue,
#    and -y answers yes to that too.
# 4. Installing a name that is exactly a package's name installs that package. Stock slpkg offers
#    every package whose name contains it, all chosen (install acct: libnetfilter_acct, nfacct,
#    pmacct and PostgreSQL), and the same across repositories; a name that is a package comes from the
#    first repository, in priority order, that has it. Names that are no package stay patterns.
diff -ru a/slpkg/all_repos.py b/slpkg/all_repos.py
--- a/slpkg/all_repos.py	2026-09-30 17:30:12.000000000 +0100
+++ b/slpkg/all_repos.py	2026-11-04 10:43:56.977089093 +0000
@@ -81,8 +81,12 @@
             view_process.message("Databases loading")
 
         raw_repo_data: list[tuple[str, dict[str, Any], list[str], bool]] = []
-        for repo_name in priority_repos:
-            data = self.load_data.load(repo_name, message=False)
+        loaded = [(repo_name, self.load_data.load(repo_name, message=False)) for repo_name in priority_repos]
+        # Iskra: a term that is exactly a package's name means that package, from the first repository
+        # (in priority order) that has it; only a term that names no package is a substring pattern
+        all_names: set[str] = set().union(*(set(d) for _, d in loaded)) if loaded else set()
+        claimed: set[str] = set()
+        for repo_name, data in loaded:
 
             if self.mode == "upgrade":
                 upgrade = Upgrade(repo_name, data, self.options)
@@ -97,10 +101,17 @@
                 packages = new_packages + upgrade_packages
             else:
                 # install: filter by search terms (case-sensitive substring match)
-                packages = [
-                    p for p in data
-                    if any(term in p for term in self.packages)
-                ]
+                packages = []
+                for p in data:
+                    for term in self.packages:
+                        if term in all_names:
+                            if p == term and term not in claimed:
+                                packages.append(p)
+                                claimed.add(term)
+                                break
+                        elif term in p:
+                            packages.append(p)
+                            break
 
             if not packages:
                 logger.info("No %s packages in '%s'.", self.mode, repo_name)
diff -ru a/slpkg/choose_packages.py b/slpkg/choose_packages.py
--- a/slpkg/choose_packages.py	2026-09-30 17:30:12.000000000 +0100
+++ b/slpkg/choose_packages.py	2026-11-04 10:43:35.150591889 +0000
@@ -281,10 +281,19 @@
         logger.debug("Choosing packages for other methods (install/tracking). Input packages: %s", ", ".join(packages))
         sorted_queries = sorted(packages)
         seen: set[str] = set()
+        # Iskra: a query that is exactly a package's name means that package; only a query that
+        # names no package is a pattern, offering every package whose name contains it
+        # (across repositories a package is listed as "name [repo]", once for each repository that has
+        # it, in priority order: an exact name takes the first)
+        first: dict[str, str] = {}
+        for name, _, _ in self._iter_packages(data):
+            first.setdefault(name.split(" [", 1)[0], name)
+        exact = {q for q in sorted_queries if q in first}
 
         for package_name, version, repo_name in self._iter_packages(data):
             for pkg_query in sorted_queries:
-                if pkg_query in package_name or pkg_query == "*":
+                if (package_name == first[pkg_query] if pkg_query in exact
+                        else pkg_query in package_name or pkg_query == "*"):
                     if package_name not in seen:
                         seen.add(package_name)
                         self.match_packages.append(package_name)
