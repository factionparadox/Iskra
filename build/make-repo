#!/usr/bin/env python3
"""Make a Slackware package repository of a folder of packages, signed, for slpkg (and sparkpkg).

  build/make-repo DIR

DIR holds the .txz packages (and requires.json from build/build-packages). Writes, beside them:
  PACKAGES.TXT      every package: name, sizes, what it requires, its description
  CHECKSUMS.md5     every file's MD5, as Slackware's own repositories have
  MANIFEST.bz2      every package's file list (sparkpkg finds dependencies by their files)
  ChangeLog.txt     when, and what changed since the last PACKAGES.TXT (slpkg checks it for news)
  GPG-KEY           the public signing key
  *.asc             a signature for each package, and for CHECKSUMS.md5

Signing: the secret key comes from ISKRA_SIGNING_KEY (the armoured secret key, as CI's secret
holds it) or an already-set GNUPGHOME; ISKRA_KEY_FPR says which key. Without a key, nothing is
signed and the repository is marked unsigned: sparkpkg won't install from it until it is.
"""
import bz2, datetime, hashlib, json, os, subprocess, sys, tarfile, tempfile
from pathlib import Path


def slack_desc(tf, name):
    try:
        text = tf.extractfile('install/slack-desc').read().decode('utf-8', 'replace')
    except (KeyError, AttributeError):
        return [f'{name}: {name}']
    lines = [l for l in text.splitlines() if l.startswith(name + ':')]
    return lines[:11] or [f'{name}: {name}']


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__.strip())
        return 0 if argv else 2
    d = Path(argv[0])
    pkgs = sorted(d.glob('*.t?z'))
    if not pkgs:
        raise SystemExit(f'make-repo: no packages in {d}')
    req = json.loads((d / 'requires.json').read_text()) if (d / 'requires.json').is_file() else {}
    old = set()
    if (d / 'PACKAGES.TXT').is_file():
        old = {l.split(':', 1)[1].strip() for l in (d / 'PACKAGES.TXT').read_text().splitlines()
               if l.startswith('PACKAGE NAME:')}
    now = datetime.datetime.now(datetime.timezone.utc)

    packages_txt = [f'PACKAGES.TXT;  {now:%a %b %d %H:%M:%S UTC %Y}', '',
                    "This file lists Iskra's packages: github.com/factionparadox/iskra", '']
    manifest = []
    for p in pkgs:
        name = p.name.rsplit('-', 3)[0]
        with tarfile.open(p) as tf:
            members = tf.getmembers()
            size_u = sum(m.size for m in members) // 1024
            desc = slack_desc(tf, name)
        manifest += ['++' + '=' * 70, '||', f'||   Package:  ./{p.name}', '||', '++' + '=' * 70]
        for m in members:
            kind = 'd' if m.isdir() else 'l' if m.issym() else '-'
            mode = ''.join(c if m.mode & b else '-' for c, b in zip('rwxrwxrwx', (256, 128, 64, 32, 16, 8, 4, 2, 1)))
            when = datetime.datetime.fromtimestamp(m.mtime, datetime.timezone.utc)
            path = m.name if m.name.startswith('./') else './' + m.name if m.name != '.' else './'
            manifest.append(f'{kind}{mode} {m.uname or "root"}/{m.gname or "root"} {m.size:>10} '
                            f'{when:%Y-%m-%d %H:%M} {path}' + (f' -> {m.linkname}' if m.issym() else ''))
        manifest.append('')
        packages_txt += [f'PACKAGE NAME:  {p.name}', 'PACKAGE LOCATION:  .',
                         f'PACKAGE SIZE (compressed):  {p.stat().st_size // 1024} K',
                         f'PACKAGE SIZE (uncompressed):  {size_u} K',
                         f'PACKAGE REQUIRED:  {",".join(req.get(name, []))}',
                         'PACKAGE DESCRIPTION:', *desc, '']
    (d / 'PACKAGES.TXT').write_text('\n'.join(packages_txt) + '\n')
    with bz2.open(d / 'MANIFEST.bz2', 'wt') as f:
        f.write('\n'.join(manifest) + '\n')

    new = {p.name for p in pkgs}
    changes = [f'{n}:  Added.' for n in sorted(new - old)] + [f'{n}:  Removed.' for n in sorted(old - new)]
    log = d / 'ChangeLog.txt'
    entry = f'{now:%a %b %d %H:%M:%S UTC %Y}\n' + ('\n'.join(changes) if changes else 'Rebuilt.') + '\n'
    entry += '+' + '-' * 26 + '+\n'
    log.write_text(entry + (log.read_text() if log.is_file() else ''))

    # signatures
    key = os.environ.get('ISKRA_SIGNING_KEY')
    fpr = os.environ.get('ISKRA_KEY_FPR', '')
    home = os.environ.get('GNUPGHOME')
    tmp = None
    if key:
        tmp = tempfile.mkdtemp()
        os.chmod(tmp, 0o700)
        home = tmp
        subprocess.run(['gpg', '--homedir', home, '--batch', '--quiet', '--import'], input=key.encode(), check=True)
    signed = False
    if home:
        if not fpr:
            out = subprocess.run(['gpg', '--homedir', home, '--batch', '--with-colons', '--list-secret-keys'],
                                 capture_output=True, text=True).stdout
            fprs = [l.split(':')[9] for l in out.splitlines() if l.startswith('fpr')]
            fpr = fprs[0] if fprs else ''
        if fpr:
            gpg = ['gpg', '--homedir', home, '--batch', '--yes', '--pinentry-mode', 'loopback', '--passphrase', '',
                   '--local-user', fpr]
            for p in pkgs:
                subprocess.run(gpg + ['--armor', '--detach-sign', '-o', f'{p}.asc', str(p)], check=True)
            with open(d / 'GPG-KEY', 'w') as f:
                subprocess.run(['gpg', '--homedir', home, '--batch', '--armor', '--export', fpr], stdout=f, check=True)
            signed = True
    if not signed:
        for f in d.glob('*.asc'):
            f.unlink()
        (d / 'UNSIGNED').write_text('No signing key was given: these packages are not signed.\n')
    else:
        (d / 'UNSIGNED').unlink(missing_ok=True)

    sums = []
    for f in sorted(d.iterdir()):
        if f.is_file() and f.name not in ('CHECKSUMS.md5', 'CHECKSUMS.md5.asc'):
            sums.append(f'{hashlib.md5(f.read_bytes()).hexdigest()}  ./{f.name}')
    (d / 'CHECKSUMS.md5').write_text('\n'.join(sums) + '\n')
    if signed:
        subprocess.run(gpg + ['--armor', '--detach-sign', '-o', str(d / 'CHECKSUMS.md5.asc'),
                              str(d / 'CHECKSUMS.md5')], check=True)
    if tmp:
        subprocess.run(['rm', '-rf', tmp])
    print(f'make-repo: {len(pkgs)} packages in {d}, ' + (f'signed by {fpr}' if signed else 'NOT signed'))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
