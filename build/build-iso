#!/usr/bin/env bash
# build-iso: Iskra's install stick, made on any Linux (Arch on WSL is fine). Nothing is compiled:
# every package is ready-made (Slackware's own, Iskra's from its CI, AlienBOB's and conraid's), and
# every one is checked against its maker's signature before it goes on the stick.
#
#   sudo build/build-iso                 makes out/iskra-VERSION-x86_64.iso
#
# How: build/slackware-root makes a Slackware -current system in a folder (its packages are kept
# in ~/.cache/iskra/slackware for next time). Iskra's slpkg, fakeroot and sparkpkg go in it, and
# sparkpkg fetches the Iskra package and everything it needs. Then liveslak (AlienBOB's Slackware
# Live builder, at a pinned commit) runs inside it and makes the stick: Slackware's series
# a ap d l n x xap, then Iskra, with Iskra's boot menu, the live session and iskra-install.
#
# Settings (environment):
#   ISKRA_REPO     Iskra's package repository (default: this repository's release "packages")
#   ISKRA_WORK     where the work happens (default: build/work/iso; needs about 25 GB)
#   SLACK_CACHE    Slackware's packages, kept between builds (default ~/.cache/iskra/slackware)
set -Eeuo pipefail
trap 'echo "build-iso: stopped at line $LINENO (exit $?)" >&2' ERR
HERE=$(cd "$(dirname "$0")/.." && pwd)
VERSION=$(cat "$HERE/VERSION")
WORK=${ISKRA_WORK:-$HERE/build/work/iso}
ROOT=$WORK/root
OUT=$HERE/out
ISKRA_REPO=${ISKRA_REPO:-https://github.com/factionparadox/Iskra/releases/download/packages}
USERHOME=$(getent passwd "${SUDO_USER:-root}" | cut -d: -f6)
CACHE=${SLACK_CACHE:-$USERHOME/.cache/iskra/slackware}
MIRROR=${SLACK_MIRROR:-https://slackware.uk/slackware/slackware64-current}
SERIES="a ap d l n x xap"
LIVESLAK=https://git.liveslak.org/liveslak
LIVESLAK_COMMIT=9c54b0835b825b41e40a4853f3b3b30694aea35f
say() { printf '\n==> %s\n' "$*"; }
die() { printf '\nbuild-iso: %s\n' "$*" >&2; exit 2; }
[[ $EUID -eq 0 ]] || die "run it with sudo (it builds a system in a folder, as root)"
for t in curl gpg git chroot mount; do command -v $t >/dev/null || die "$t is needed"; done
mkdir -p "$WORK" "$OUT"

run() {   # a command inside ROOT, as root
  chroot "$ROOT" env -i HOME=/root TERM="${TERM:-dumb}" LANG=C.UTF-8 \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    ${https_proxy:+https_proxy=$https_proxy} ${http_proxy:+http_proxy=$http_proxy} "$@"
}
unmount_all() {
  for d in tmp/slackrepo dev/pts dev sys proc; do
    mountpoint -q "$ROOT/$d" 2>/dev/null && umount -l "$ROOT/$d"
  done
  true
}
trap unmount_all EXIT

say "A Slackware -current system to build the stick in (series: $SERIES)"
SLACK_CACHE=$CACHE "$HERE/build/slackware-root" "$ROOT" $SERIES
for d in proc sys dev dev/pts; do mkdir -p "$ROOT/$d"; mountpoint -q "$ROOT/$d" || mount --bind "/$d" "$ROOT/$d"; done
cp -L /etc/resolv.conf "$ROOT/etc/resolv.conf"

say "Each series' tagfile (which packages liveslak puts on the stick), checked against Slackware's signed list"
for s in $SERIES; do
  f=slackware64/$s/tagfile
  sum=$(awk -v f="./$f" '$2 == f { print $1 }' "$CACHE/CHECKSUMS.md5")
  [[ -n $sum ]] || die "no tagfile for series $s in Slackware's list"
  [[ -f $CACHE/$f ]] && echo "$sum  $CACHE/$f" | md5sum -c --status ||
    curl -fsSL --retry 3 -o "$CACHE/$f" "$MIRROR/$f"
  echo "$sum  $CACHE/$f" | md5sum -c --status || die "$f does not match Slackware's signed checksum"
done

say "Iskra's own package tools (slpkg, fakeroot, sparkpkg), from Iskra's signed repository"
repo=$WORK/iskra-repo; mkdir -p "$repo"
g=$(mktemp -d); chmod 700 "$g"
keys=$HERE/desktop/root/usr/share/sparkpkg/keys
fpr=$(awk '$1 == "iskra" { print $2 }' "$keys/FINGERPRINTS")
[[ -n $fpr && -f $keys/iskra.asc ]] || die "Iskra's signing key isn't pinned yet (desktop/root/usr/share/sparkpkg/keys): run build/make-signing-key, and let CI publish the packages"
gpg --homedir "$g" --batch --quiet --import "$keys/iskra.asc"
for f in CHECKSUMS.md5 CHECKSUMS.md5.asc PACKAGES.TXT; do curl -fsSL --retry 3 -o "$repo/$f" "$ISKRA_REPO/$f"; done
gpg --homedir "$g" --batch --status-fd 1 --verify "$repo/CHECKSUMS.md5.asc" "$repo/CHECKSUMS.md5" 2>/dev/null |
  grep -q "VALIDSIG $fpr" || die "Iskra's package list is not signed by Iskra's key $fpr"
echo "    signed by $fpr"
for p in slpkg fakeroot sparkpkg; do
  file=$(awk -v p="$p" '$2 ~ "^\\./" p "-[^-]+-[^-]+-[^-]+\\.txz$" { sub("^\\./", "", $2); print $2 }' "$repo/CHECKSUMS.md5" | head -n 1)
  [[ -n $file ]] || die "Iskra's repository has no $p package yet (has CI published it?)"
  [[ -f $repo/$file ]] || curl -fsSL --retry 3 -o "$repo/$file" "$ISKRA_REPO/$file"
  curl -fsSL --retry 3 -o "$repo/$file.asc" "$ISKRA_REPO/$file.asc"
  sum=$(awk -v f="./$file" '$2 == f { print $1 }' "$repo/CHECKSUMS.md5")
  echo "$sum  $repo/$file" | md5sum -c --status || die "$file does not match Iskra's signed checksum"
  gpg --homedir "$g" --batch --status-fd 1 --verify "$repo/$file.asc" "$repo/$file" 2>/dev/null |
    grep -q "VALIDSIG $fpr" || die "$file is not signed by Iskra's key"
  # installed from inside ROOT: Slackware's upgradepkg calls /sbin/installpkg, which only ROOT has
  cp "$repo/$file" "$ROOT/tmp/"
  run /sbin/upgradepkg --install-new --reinstall "/tmp/$file" >/dev/null
  rm -f "$ROOT/tmp/$file"
  echo "    $file"
done
rm -rf "$g"
# in the build system, Iskra's repository is on, and its key is trusted like the others
sed -i '/^\[ISKRA\]/,/^TAG/ s/^ENABLE = false/ENABLE = true/' "$ROOT/etc/slpkg/repositories.toml"
sed -i "s|^MIRROR = \"https://github.com/factionparadox/Iskra/releases/download/packages/\"|MIRROR = \"$ISKRA_REPO/\"|" "$ROOT/etc/slpkg/repositories.toml"
cp "$keys/iskra.asc" "$keys/FINGERPRINTS" "$ROOT/usr/share/sparkpkg/keys/"

say "The repositories' package lists (sparkpkg sync)"
run sh -c "yes y | sparkpkg sync" > "$WORK/sync.log" 2>&1 || { tail -30 "$WORK/sync.log"; die "sparkpkg sync failed"; }
grep -E "trusted|Error" "$WORK/sync.log" || true

say "Iskra, and everything it needs that Slackware's series don't have"
want=$(run /usr/lib/sparkpkg/assimilate expand iskra)
echo "$want" | tr '\n' ' ' | fold -s -w 96 | sed 's/^/    /'; echo
LS=$ROOT/tmp/liveslak
rm -rf "$LS/local64/iskra"; mkdir -p "$LS/local64"
run /usr/lib/sparkpkg/assimilate fetch /tmp/liveslak/local64/iskra $want

say "liveslak, at commit ${LIVESLAK_COMMIT:0:12}"
if [[ ! -d $WORK/liveslak/.git ]]; then git clone -q "$LIVESLAK" "$WORK/liveslak"; fi
git -C "$WORK/liveslak" fetch -q origin
git -C "$WORK/liveslak" -c advice.detachedHead=false checkout -q "$LIVESLAK_COMMIT"
rsync -a --delete --exclude=.git --exclude=local64 "$WORK/liveslak/" "$LS/"
# Iskra's settings and its live session (build/iso/make_slackware_live.conf), and its installer
cp "$HERE/build/iso/make_slackware_live.conf" "$LS/make_slackware_live.conf"
install -m755 "$HERE/build/iso/iskra-install" "$LS/iskra-install"
mkdir -p "$LS/iskra-media"
cp -a "$HERE/desktop/root/usr/share/iskra/grub-theme/." "$LS/iskra-media/grub-theme/"
cp "$HERE/desktop/root/usr/share/iskra/iskra-wallpaper.png" "$LS/iskra-media/"
# the boot menu: Iskra's theme in place of liveslak's, its fonts loaded, Iskra's name on the entries
rm -rf "$LS/EFI/BOOT/liveslak"; cp -a "$HERE/desktop/root/usr/share/iskra/grub-theme" "$LS/EFI/BOOT/liveslak"
sed -i -e 's|^  set gfxmode=.*|  set gfxmode=auto\n  loadfont $cmdpath/liveslak/menu.pf2\n  loadfont $cmdpath/liveslak/menu-bold.pf2\n  loadfont $cmdpath/liveslak/hint.pf2|' \
       -e 's|^menuentry "Start @CDISTRO@@DIRSUFFIX@ @SL_VERSION@ @LIVEDE@ liveslak-@VERSION@ (\$sl_lang)"|menuentry "Start Iskra '"$VERSION"' (live; install with: sudo iskra-install)"|' \
       "$LS/grub.tpl"
grep -q 'menu.pf2' "$LS/grub.tpl" && grep -q 'Start Iskra' "$LS/grub.tpl" || die "liveslak's boot menu has changed; build/build-iso needs updating"

say "Slackware's own documents, which liveslak puts on the stick (checked against Slackware's signed list)"
awk '$2 ~ /^\.\/(ANNOUNCE|CHANGES_AND_HINTS|COPY|CRYPTO|README|RELEASE_NOTES|SPEAK|[^\/]*HOWTO|UPGRADE)[^\/]*$/ ||
     $2 ~ /^\.\/usb-and-pxe-installers\/README[^\/]*$/ { sub("^\\./", "", $2); print $1, $2 }' "$CACHE/CHECKSUMS.md5" |
while read -r sum f; do
  mkdir -p "$CACHE/$(dirname "$f")"
  if ! { [[ -f $CACHE/$f ]] && echo "$sum  $CACHE/$f" | md5sum -c --status; }; then
    curl -fsSL --retry 3 -o "$CACHE/$f" "$MIRROR/$f"
    echo "$sum  $CACHE/$f" | md5sum -c --status || die "$f does not match Slackware's signed checksum"
  fi
  echo "    $f"
done

say "The stick (liveslak's make_slackware_live.sh, in the Slackware system)"
mkdir -p "$ROOT/tmp/slackrepo/slackware64-current"
mountpoint -q "$ROOT/tmp/slackrepo/slackware64-current" || mount --bind "$CACHE" "$ROOT/tmp/slackrepo/slackware64-current"
iso=iskra-$VERSION-x86_64.iso
rm -f "$ROOT/tmp/$iso"
run sh -c "cd /tmp/liveslak && ./make_slackware_live.sh -d ISKRA -l gb -R 3 -H iskra -X -t doc \
             -s /tmp/slackrepo -O /tmp/$iso" 2>&1 | tee "$WORK/liveslak.log"
[[ -s $ROOT/tmp/$iso ]] || die "liveslak made no ISO (its log: $WORK/liveslak.log)"
umount -l "$ROOT/tmp/slackrepo/slackware64-current"
mv "$ROOT/tmp/$iso" "$OUT/$iso"
( cd "$OUT" && sha256sum "$iso" > "$iso.sha256" )
[[ -n ${SUDO_USER:-} ]] && chown "$SUDO_USER:" "$OUT/$iso" "$OUT/$iso.sha256"
say "Done: $OUT/$iso ($(du -h "$OUT/$iso" | cut -f1))"
echo "    Write it to a USB stick (Ventoy, Rufus or dd), turn Secure Boot off, start the laptop from it"
echo "    in UEFI mode. Live session: user live, password live. To install: sudo iskra-install"
