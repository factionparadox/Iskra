#!/bin/sh
# avalon-firstboot: Avalon's first boot. /etc/rc.local runs it while the flag file exists: it
# gets online (the Wi-Fi the installer was given, or a cable), then builds Avalon on this
# laptop with avalon-setup, showing every build, and reboots into the Garden System.
# If something fails it says so and leaves you at a login: fix it and run  avalon-firstboot
FLAG=/var/lib/avalon/firstboot
LOG=/var/log/avalon-firstboot.log
[ -f $FLAG ] || exit 0
USER_NAME=$(cat $FLAG)

say() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
online() { ping -c 1 -W 3 crux.nu >/dev/null 2>&1; }

clear 2>/dev/null
printf '\033[1;36m%s\033[0m\n' "Avalon 1 (Iskra): first boot. Building the Garden System on this laptop."

if ! online; then
	say "Getting online"
	wifi=$(ls -d /sys/class/net/*/wireless 2>/dev/null | head -1); wifi=${wifi%/wireless}; wifi=${wifi##*/}
	if [ -n "$wifi" ] && [ -f /etc/wpa_supplicant-avalon.conf ]; then
		echo "    Wi-Fi on $wifi"
		ip link set "$wifi" up
		wpa_supplicant -B -i "$wifi" -c /etc/wpa_supplicant-avalon.conf -P /run/avalon-wpa.pid
	fi
	dhcpcd -w -t 60 >/dev/null 2>&1 &
	i=0; while ! online && [ $i -lt 60 ]; do sleep 2; i=$((i + 1)); done
fi
if ! online; then
	echo
	echo "No internet. Log in as root, get online (a cable, or wpa_supplicant + dhcpcd), then run:"
	echo "    avalon-firstboot"
	exit 0
fi
echo "    online"

status=/run/avalon-firstboot.status
( /usr/ports/avalon/avalon-setup "$USER_NAME"; echo $? > $status ) 2>&1 | tee -a $LOG
if [ "$(cat $status 2>/dev/null)" != 0 ]; then
	echo
	echo "The build stopped (the whole log: $LOG). Log in as root, fix it, and run:  avalon-firstboot"
	echo "It carries on from where it stopped. Portage is there too, if you need it: metamelayer gentoo"
	exit 0
fi

rm -f $FLAG /etc/wpa_supplicant-avalon.conf
[ -f /run/avalon-wpa.pid ] && kill "$(cat /run/avalon-wpa.pid)" 2>/dev/null
say "Avalon is built. Rebooting into the Garden System..."
sleep 5
reboot
