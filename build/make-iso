#!/bin/sh
# make-iso: an installer USB image for Avalon, from the image make-image built.
#     sudo build/make-image && sudo build/make-iso
# It uses Fedora's own installer (Anaconda), graphical, with the language, keyboard and time
# zone set for you (British English, UK, London): you choose the disk and your user, it installs
# Avalon, you restart. Result: avalon-1-iskra.iso here. Write it with Rufus (DD mode) or dd.
set -eu
cd "$(dirname "$0")/.."
[ "$(id -u)" = 0 ] || { echo "make-iso: run it as root: sudo $0" >&2; exit 1; }
podman image exists localhost/avalon:latest || { echo "make-iso: build the image first: sudo build/make-image" >&2; exit 1; }
work=$(mktemp -d /var/tmp/avalon-iso.XXXXXX)
trap 'rm -rf "$work"' EXIT
cat > "$work/config.toml" <<'TOML'
[customizations.installer.kickstart]
contents = """
graphical
lang en_GB.UTF-8
keyboard gb
timezone Europe/London
"""
TOML
mkdir -p "$work/output"
podman run --rm -it --privileged --pull=newer \
	--security-opt label=type:unconfined_t \
	-v "$work/config.toml":/config.toml:ro \
	-v "$work/output":/output \
	-v /var/lib/containers/storage:/var/lib/containers/storage \
	quay.io/centos-bootc/bootc-image-builder:latest \
	--type anaconda-iso --rootfs btrfs --use-librepo=True \
	localhost/avalon:latest
iso=$(find "$work/output" -name '*.iso' | head -1)
[ -n "$iso" ] || { echo "make-iso: no ISO came out" >&2; exit 1; }
mv "$iso" avalon-1-iskra.iso
[ -n "${SUDO_USER:-}" ] && chown "$SUDO_USER:" avalon-1-iskra.iso
sha256sum avalon-1-iskra.iso > avalon-1-iskra.iso.sha256
ls -lh avalon-1-iskra.iso
