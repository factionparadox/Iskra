#!/bin/sh
# make-image: build the Avalon image on this machine (Arch, Arch on WSL, or Avalon itself).
#     sudo build/make-image
# Rootful podman, so bootc and the ISO builder can use the image. Nothing is compiled: Universal
# Blue's base is pulled, Fedora's packages are installed into it, Avalon's files copied in.
set -eu
cd "$(dirname "$0")/.."
[ "$(id -u)" = 0 ] || { echo "make-image: run it as root: sudo $0" >&2; exit 1; }
command -v podman >/dev/null || { command -v pacman >/dev/null && pacman -S --needed --noconfirm podman; }
command -v podman >/dev/null || { echo "make-image: podman is needed" >&2; exit 1; }
podman build --pull=newer -t localhost/avalon:latest -f Containerfile .
podman image prune -f >/dev/null 2>&1 || true
podman images localhost/avalon
