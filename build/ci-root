#!/usr/bin/env bash
# ci-root: make a Slackware -current root (from build/slackware-root) a system that can build
# Iskra's packages: the network, /proc and friends, fakeroot and Iskra's slpkg (built from Ponce's
# SlackBuilds, with packages/slpkg/iskra.patch), sparkpkg from this repository, its build user, and
# every repository's package lists.     sudo build/ci-root ROOT
#
# Iskra's own repository is left switched off in ROOT: ROOT is where it is built.
set -Eeuo pipefail
trap 'echo "ci-root: stopped at line $LINENO (exit $?)" >&2' ERR
ROOT=${1:?usage: ci-root ROOT}
HERE=$(cd "$(dirname "$0")/.." && pwd)
say() { printf '\n==> %s\n' "$*"; }
[[ $EUID -eq 0 ]] || { echo "ci-root: run it with sudo" >&2; exit 2; }

say "Mounting /proc, /sys and /dev in $ROOT"
for d in proc sys dev dev/pts; do
  mkdir -p "$ROOT/$d"
  mountpoint -q "$ROOT/$d" || mount --bind "/$d" "$ROOT/$d"
done
cp -L /etc/resolv.conf "$ROOT/etc/resolv.conf"

run() {   # a command in ROOT, as root, with the network settings this machine has
  chroot "$ROOT" env -i HOME=/root TERM=dumb LANG=C.UTF-8 \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    ${https_proxy:+https_proxy=$https_proxy} ${http_proxy:+http_proxy=$http_proxy} \
    ${SSL_CERT_FILE:+SSL_CERT_FILE=$SSL_CERT_FILE} ${CURL_CA_BUNDLE:+CURL_CA_BUNDLE=$CURL_CA_BUNDLE} \
    ${GIT_SSL_CAINFO:+GIT_SSL_CAINFO=$GIT_SSL_CAINFO} "$@"
}
run /sbin/ldconfig
# the certificate store (an older root, made before slackware-root did this itself)
[[ -s $ROOT/etc/ssl/certs/ca-certificates.crt ]] || run /usr/sbin/update-ca-certificates --fresh >/dev/null

say "sparkpkg, from this repository"
src=$HERE/desktop/root
install -Dm755 "$src/usr/bin/sparkpkg" "$ROOT/usr/bin/sparkpkg"
mkdir -p "$ROOT/usr/lib/sparkpkg" "$ROOT/usr/share" "$ROOT/etc/slpkg" "$ROOT/etc/ld.so.conf.d" "$ROOT/etc/profile.d"
install -m755 "$src/usr/lib/sparkpkg/assimilate" "$ROOT/usr/lib/sparkpkg/"
install -m644 "$src/usr/lib/sparkpkg/pkgbuild.sh" "$ROOT/usr/lib/sparkpkg/"
cp -a "$src/usr/share/sparkpkg" "$ROOT/usr/share/"
cp "$src"/etc/slpkg/*.toml "$ROOT/etc/slpkg/"
cp "$src/etc/ld.so.conf.d/sparkpkg.conf" "$ROOT/etc/ld.so.conf.d/"
cp "$src/etc/profile.d/sparkpkg.sh" "$ROOT/etc/profile.d/"
sed -i '/^\[ISKRA\]/,/^TAG/ s/^ENABLE = true/ENABLE = false/' "$ROOT/etc/slpkg/repositories.toml"
grep -q '^sparkpkg:' "$ROOT/etc/passwd" || {
  run groupadd -r sparkpkg
  run useradd -r -g sparkpkg -d /var/lib/sparkpkg -s /bin/false -c "sparkpkg builds" sparkpkg
}
mkdir -p "$ROOT/var/cache/sparkpkg" && run chown sparkpkg:sparkpkg /var/cache/sparkpkg

say "fakeroot and Iskra's slpkg, from Ponce's SlackBuilds"
b=$ROOT/tmp/ci-bootstrap
rm -rf "$b"; mkdir -p "$b"
git clone -q --depth 1 -b current https://github.com/Ponce/slackbuilds.git "$b/ponce"
for p in fakeroot slpkg; do
  if run sh -c "ls /var/lib/pkgtools/packages | grep -q '^$p-'"; then echo "    $p: installed"; continue; fi
  d=$(dirname "$b"/ponce/*/"$p"/"$p".info)
  ( cd "$d"
    . ./"$p".info
    for u in ${DOWNLOAD_x86_64:-$DOWNLOAD}; do curl -fsSL --retry 3 -o "${u##*/}" "$u"; done
    sums=(${MD5SUM_x86_64:-$MD5SUM}); i=0
    for u in ${DOWNLOAD_x86_64:-$DOWNLOAD}; do
      echo "${sums[i]}  ${u##*/}" | md5sum -c --quiet; i=$((i + 1))
    done
    if [[ $p == slpkg ]]; then
      cp "$HERE/packages/slpkg/iskra.patch" .
      sed -i 's|^cd \$PRGNAM-\$VERSION$|&\npatch -p1 < $CWD/iskra.patch|' slpkg.SlackBuild
      grep -q iskra.patch slpkg.SlackBuild
    fi )
  rel=${d#"$ROOT"}
  run sh -c "cd $rel && OUTPUT=/tmp/ci-bootstrap TAG=_iskra sh ./$p.SlackBuild > /tmp/ci-bootstrap/$p.log 2>&1" ||
    { tail -40 "$b/$p.log"; exit 1; }
  run sh -c "upgradepkg --install-new /tmp/ci-bootstrap/$p-*_iskra.t?z"
done

say "The repositories' package lists (sparkpkg sync)"
run sparkpkg sync < /dev/null
echo
echo "ci-root: $ROOT can build Iskra's packages:  sudo build/build-packages $ROOT OUT"
