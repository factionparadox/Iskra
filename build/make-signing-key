#!/usr/bin/env bash
# make-signing-key: make Iskra's package-signing key, once. Run it on your own computer (Arch is
# fine), not in CI:
#
#   curl -fsSL https://raw.githubusercontent.com/factionparadox/iskra/main/build/make-signing-key | bash
#
# What it does:
#   1. makes a new signing-only key (ed25519) in a throwaway folder
#   2. stores its secret half as the repository's Actions secret ISKRA_SIGNING_KEY, where only
#      Iskra's CI can use it (GitHub never shows a secret again, not even to you)
#   3. keeps one copy of the secret half in ~/iskra-signing-key.asc, readable only by you, in case
#      it is ever needed again; it is never committed anywhere
#   4. commits the public half (desktop/root/usr/share/sparkpkg/keys/iskra.asc) and its fingerprint
#      (FINGERPRINTS), so sparkpkg trusts packages signed with it. That commit starts CI, which
#      builds, signs and publishes the packages.
# It needs gpg and GitHub's gh (installed with pacman if missing), and asks you to log in to
# GitHub (gh auth login) if gh isn't already.
set -euo pipefail
REPO=${ISKRA_REPO:-factionparadox/iskra}
say() { printf '\n==> %s\n' "$*"; }
die() { printf '\nmake-signing-key: %s\n' "$*" >&2; exit 1; }

command -v gpg >/dev/null || die "gpg is needed (sudo pacman -S gnupg)"
if ! command -v gh >/dev/null; then
  say "Installing GitHub's gh"
  command -v pacman >/dev/null || die "install GitHub's gh first: https://cli.github.com"
  sudo pacman -S --needed --noconfirm github-cli
fi
gh auth status >/dev/null 2>&1 || { say "Logging in to GitHub"; gh auth login --hostname github.com --git-protocol https --web; }

if gh secret list -R "$REPO" 2>/dev/null | grep -q '^ISKRA_SIGNING_KEY'; then
  [[ ${1:-} == --new ]] || die "$REPO already has a signing key. To replace it (packages signed with the old one stop being trusted): add --new"
fi

say "Making the key"
g=$(mktemp -d); chmod 700 "$g"; trap 'rm -rf "$g"' EXIT
gpg --homedir "$g" --batch --quiet --passphrase '' \
    --quick-gen-key "Iskra packages <iskra@users.noreply.github.com>" ed25519 sign never
fpr=$(gpg --homedir "$g" --batch --with-colons --list-secret-keys | awk -F: '/^fpr/ { print $10; exit }')
echo "    fingerprint $fpr"

say "Storing the secret half as $REPO's secret ISKRA_SIGNING_KEY"
gpg --homedir "$g" --batch --armor --export-secret-keys "$fpr" | gh secret set ISKRA_SIGNING_KEY -R "$REPO"
backup=$HOME/iskra-signing-key.asc
( umask 077; gpg --homedir "$g" --batch --armor --export-secret-keys "$fpr" > "$backup" )
echo "    your copy: $backup (only you can read it; keep it, and never commit it)"

say "Committing the public half, so sparkpkg trusts it"
pub=$(gpg --homedir "$g" --batch --armor --export "$fpr")
put() {   # put a file in the repository with one commit: path, content, message
  local path=$1 content=$2 msg=$3 sha
  sha=$(gh api "repos/$REPO/contents/$path" --jq .sha 2>/dev/null || true)
  gh api -X PUT "repos/$REPO/contents/$path" -f message="$msg" \
    -f content="$(printf '%s\n' "$content" | base64 -w0)" ${sha:+-f sha="$sha"} --jq .commit.sha >/dev/null
}
put desktop/root/usr/share/sparkpkg/keys/iskra.asc "$pub" "Iskra's package-signing key (public half)"
fp=$(gh api "repos/$REPO/contents/desktop/root/usr/share/sparkpkg/keys/FINGERPRINTS" --jq .content | base64 -d)
fp=$(printf '%s\n' "$fp" | grep -v '^#* *iskra ')
fp=$(printf '%s\niskra    %s   Iskra packages (github.com/%s)\n' "$fp" "$fpr" "$REPO")
put desktop/root/usr/share/sparkpkg/keys/FINGERPRINTS "$fp" "Pin Iskra's package-signing key $fpr"

say "Done"
echo "Iskra's packages will be signed with $fpr. CI is building them now:"
echo "    https://github.com/$REPO/actions"
