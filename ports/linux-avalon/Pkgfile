# Description: Avalon's kernel: Linux 7.3 on CRUX's own modular config, with the Panther Lake graphics, NPU and Wi-Fi switched on
# URL: https://www.kernel.org
# Maintainer: Avalon
# Depends on: linux-firmware

name=linux-avalon
version=7.3.1
release=1
source=(https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$version.tar.xz config)

build() {
  cd linux-$version
  cp $SRC/config .config
  # Framework Laptop 13 Pro (Core Ultra 5 325): Xe3 graphics, NPU, Wi-Fi 7, sound; root filesystems built
  # in so no initramfs is needed; no debug info or module signing (faster build, smaller package)
  scripts/config --set-str LOCALVERSION "-avalon" \
    -m DRM_XE -m DRM_I915 -m DRM_ACCEL_IVPU -m IWLWIFI -m IWLMVM -m IWLMLD \
    -m SND_SOC_SOF_PANTHERLAKE -m PINCTRL_INTEL_PLATFORM -m I2C_HID_ACPI \
    -e EFI_STUB -e BLK_DEV_NVME -e EXT4_FS -e XFS_FS -e BTRFS_FS \
    -d DEBUG_INFO -e DEBUG_INFO_NONE -d DEBUG_INFO_DWARF5 -d DEBUG_INFO_BTF \
    -d MODULE_SIG -d RUST
  make olddefconfig
  make bzImage modules
  make INSTALL_MOD_PATH=$PKG INSTALL_MOD_STRIP=1 modules_install
  rm -f $PKG/lib/modules/*/build $PKG/lib/modules/*/source
  install -D -m 644 arch/x86/boot/bzImage $PKG/boot/vmlinuz-avalon
  install -m 644 System.map $PKG/boot/System.map-avalon
  install -m 644 .config $PKG/boot/config-avalon
}
