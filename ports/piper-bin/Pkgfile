# Description: Piper, the local text-to-speech Neredy reads Russian aloud with (its own ready-made build)
# URL: https://github.com/rhasspy/piper
# Maintainer: Avalon
# Depends on:

name=piper-bin
version=2023.11.14.2
release=1
source=(https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_linux_x86_64.tar.gz)

build() {
  # nothing compiled: Piper's own build with its libraries beside it, in /opt/piper
  install -d $PKG/opt $PKG/usr/bin
  cp -a piper $PKG/opt/piper
  ln -s /opt/piper/piper $PKG/usr/bin/piper
}
