# Description: Command line parser for C++11 (headers only; Quickshell builds with it)
# URL: https://github.com/CLIUtils/CLI11
# Maintainer: Avalon
# Depends on: cmake

name=cli11
version=2.7.2
release=1
source=(https://github.com/CLIUtils/CLI11/archive/v$version/CLI11-$version.tar.gz)

build() {
  cmake -S CLI11-$version -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_BUILD_TYPE=Release \
    -D CLI11_BUILD_TESTS=OFF \
    -D CLI11_BUILD_EXAMPLES=OFF \
    -D CLI11_BUILD_DOCS=OFF
  cmake --build build
  DESTDIR=$PKG cmake --install build
}
