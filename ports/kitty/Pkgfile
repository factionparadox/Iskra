# Description: Fast, GPU-drawn terminal that can show pictures (the kitty project's own ready-made build)
# URL: https://sw.kovidgoyal.net/kitty/
# Maintainer: Avalon
# Depends on: mesa fontconfig

name=kitty
version=0.50.0
release=1
source=(https://github.com/kovidgoyal/kitty/releases/download/v$version/$name-$version-x86_64.txz)

build() {
  # self-contained, in /opt/kitty; nothing compiled
  # (pkgmk has already unpacked it into $SRC: bin/ lib/ share/)
  install -d $PKG/opt/kitty $PKG/usr/bin $PKG/usr/share/applications $PKG/usr/share/icons
  cp -a bin lib share $PKG/opt/kitty/
  ln -s /opt/kitty/bin/kitty $PKG/usr/bin/kitty
  ln -s /opt/kitty/bin/kitten $PKG/usr/bin/kitten
  for d in $PKG/opt/kitty/share/applications/*.desktop; do
    sed 's|^Icon=.*|Icon=kitty|' $d > $PKG/usr/share/applications/${d##*/}
  done
  cp -a $PKG/opt/kitty/share/icons/hicolor $PKG/usr/share/icons/
  install -d $PKG/usr/share/man
  mv $PKG/opt/kitty/share/man/man* $PKG/usr/share/man/
  rm -rf $PKG/opt/kitty/share/doc $PKG/opt/kitty/share/man
}
