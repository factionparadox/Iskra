# Description: Avalon's Garden System: the Quickshell shell, Mango, kitty, fastfetch and greetd settings, artwork and tools
# URL: https://github.com/factionparadox/Iskra
# Maintainer: Avalon
# Depends on: mango quickshell kitty cage greetd fastfetch xorg-font-dejavu-ttf otf-noto

name=avalon-desktop
version=1
release=1
source=()

build() {
  # from this repository's own desktop/ folder: the ports collection lives inside the clone
  # (/usr/ports/avalon/ports), so the files are right beside it
  local src=$PKGMK_ROOT/../../desktop
  [ -d $src ] || { echo "avalon-desktop: no desktop/ beside the ports (is /usr/ports/avalon a clone of Avalon?)"; exit 1; }
  cp -a $src/. $PKG/
  chmod 755 $PKG/usr/bin/* $PKG/usr/sbin/* 2>/dev/null || true
  chmod 440 $PKG/etc/sudoers.d/avalon 2>/dev/null || true
  # settings you may edit go in as examples first, and avalon-setup puts them in place once
  find $PKG -type d -exec chmod 755 {} +
  chown -R root:root $PKG
}
