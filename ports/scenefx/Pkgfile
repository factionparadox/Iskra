# Description: wlroots scene renderer with effects: blur, shadows, rounded corners (Mango draws with it)
# URL: https://github.com/wlrfx/scenefx
# Maintainer: Avalon
# Depends on: wlroots mesa xorg-libpixman libdrm wayland-protocols

name=scenefx
version=0.5
release=1
source=(https://github.com/wlrfx/scenefx/archive/$version/$name-$version.tar.gz)

build() {
  meson setup $name-$version build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D examples=false
  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
