# Description: QtQuick toolkit for desktop shells: Avalon's Garden System is written in it
# URL: https://quickshell.org
# Maintainer: Avalon
# Depends on: qt6-declarative qt6-wayland qt6-svg qt6-shadertools cli11 pipewire linux-pam polkit wayland-protocols libdrm mesa spirv-tools vulkan-headers

name=quickshell
version=0.3.2
release=1
source=(https://git.outfoxxed.me/quickshell/quickshell/archive/v$version.tar.gz)
renames=($name-$version.tar.gz)

build() {
  cmake -S $name -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_BUILD_TYPE=Release \
    -D DISTRIBUTOR="Avalon (CRUX ports)" \
    -D DISTRIBUTOR_DEBUGINFO_AVAILABLE=NO \
    -D CRASH_HANDLER=OFF \
    -D USE_JEMALLOC=OFF \
    -D HYPRLAND=OFF \
    -D I3=OFF \
    -D INSTALL_QML_PREFIX=lib/qt6/qml
  cmake --build build
  DESTDIR=$PKG cmake --install build
}
