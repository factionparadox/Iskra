# Description: Wayland compositor on dwl: tags, a Niri-style scroller, animations, blur
# URL: https://github.com/mangowm/mango
# Arch: mangowm
# Maintainer: Avalon
# Depends on: scenefx wlroots cjson libpcre2 libinput libxkbcommon pango xorg-xwayland xorg-xcb-util-wm

name=mango
version=0.18.5
release=1
source=(https://github.com/mangowm/mango/archive/$version/$name-$version.tar.gz)

build() {
  meson setup $name-$version build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=plain \
    --wrap-mode nodownload
  meson compile -C build
  DESTDIR=$PKG meson install -C build
  # Mango's own example settings; Avalon's Garden System settings come with avalon-desktop
  mv $PKG/etc/mango/config.conf $PKG/etc/mango/config.conf.example
}
