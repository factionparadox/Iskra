// Avalon: fastfetch with Pasha, the Garden's keeper, drawn as a picture (kitty's image protocol).
// In a terminal that can't show pictures, fastfetch falls back to its text logo.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/usr/share/avalon/pasha-fastfetch.png",
    "width": 28,
    "height": 14,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "magenta" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[36m▰▰▰▰\u001b[33m▰▰▰▰\u001b[32m▰▰▰▰\u001b[31m▰▰▰▰\u001b[0m" },
    { "type": "os",       "key": "SYSTEM" },
    { "type": "host",     "key": "MACHINE" },
    { "type": "kernel",   "key": "KERNEL" },
    { "type": "packages", "key": "PACKAGES" },
    { "type": "wm",       "key": "GARDEN" },
    { "type": "terminal", "key": "TERMINAL" },
    { "type": "cpu",      "key": "CPU" },
    { "type": "gpu",      "key": "GPU" },
    { "type": "memory",   "key": "MEMORY" },
    { "type": "battery",  "key": "BATTERY" },
    { "type": "uptime",   "key": "UPTIME" },
    "break",
    "colors"
  ]
}
