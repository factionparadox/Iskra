// fastfetch on Iskra: Паша (Pasha), Iskra's arctic wolf pup, howling.
// Your own ~/.config/fastfetch/config.jsonc takes the place of this one.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/iskra/fastfetch/pasha.txt",
    "padding": { "top": 1, "right": 3 }
  },
  "display": { "color": { "keys": "red", "title": "red" } },
  "modules": [
    "title", "separator",
    "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "wm", "terminal", "cpu", "gpu", "memory", "disk", "battery", "locale",
    "break", "colors"
  ]
}
