#!/bin/sh
#
# /etc/rc.d/rc.iskra: Iskra's services, started at boot and stopped at shutdown.
# Slackware starts its own services from rc.M; anything else is started from rc.local, and
# rc.local calls this (rc.local_shutdown calls it with stop).
#
#   /etc/rc.d/rc.iskra start|stop|status
#
# Each service runs only if it's installed; the ones with their own Slackware script run only if
# that script is executable (chmod -x /etc/rc.d/rc.tlp stops TLP starting at boot, for example).

# battery and power: TLP's settings, Intel's thermal and low-power daemons for the 13 Pro
# clock: chrony; the firewall; the Russian tutor's language model
SERVICES="firewall tlp thermald lpmd chrony tutor"

say() { printf 'rc.iskra: %s\n' "$*"; }

start_one() {
  case $1 in
    firewall) [ -x /etc/rc.d/iskra-firewall ] && /etc/rc.d/iskra-firewall start ;;
    tlp)      [ -x /etc/rc.d/rc.tlp ] && /etc/rc.d/rc.tlp start ;;
    thermald) [ -x /usr/sbin/thermald ] && ! pgrep -x thermald >/dev/null &&
                /usr/sbin/thermald --adaptive --ignore-cpuid-check ;;
    lpmd)     [ -x /usr/bin/intel_lpmd ] && ! pgrep -x intel_lpmd >/dev/null &&
                /usr/bin/intel_lpmd ;;
    chrony)   [ -x /etc/rc.d/rc.chrony ] && /etc/rc.d/rc.chrony start ;;
    tutor)    [ -x /etc/rc.d/iskra-tutor ] && /etc/rc.d/iskra-tutor start ;;
  esac
}

stop_one() {
  case $1 in
    firewall) ;;                      # stays up until the very end
    tlp)      [ -x /etc/rc.d/rc.tlp ] && /etc/rc.d/rc.tlp stop ;;
    thermald) pkill -x thermald ;;
    lpmd)     pkill -x intel_lpmd ;;
    chrony)   [ -x /etc/rc.d/rc.chrony ] && /etc/rc.d/rc.chrony stop ;;
    tutor)    [ -x /etc/rc.d/iskra-tutor ] && /etc/rc.d/iskra-tutor stop ;;
  esac
}

case ${1:-} in
  start)
    for s in $SERVICES; do start_one $s >/dev/null 2>&1 || say "$s did not start"; done ;;
  stop)
    for s in $(echo $SERVICES | tr ' ' '\n' | tac); do stop_one $s >/dev/null 2>&1; done ;;
  status)
    for p in thermald intel_lpmd chronyd llama-server; do
      printf '%-14s %s\n' "$p" "$(pgrep -x $p >/dev/null && echo running || echo 'not running')"
    done
    [ -x /etc/rc.d/rc.tlp ] && printf '%-14s %s\n' tlp "$(tlp-stat -s 2>/dev/null | awk -F'= ' '/^State/ {print $2}')"
    printf '%-14s %s\n' firewall "$(nft list tables 2>/dev/null | grep -q iskra && echo loaded || echo 'not loaded')" ;;
  *)
    echo "usage: $0 start|stop|status" ;;
esac
