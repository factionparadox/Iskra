#!/bin/sh
# Update everything, the CRUX way: fetch the newest ports (CRUX's collections and Iskra's own,
# from this system's copy of the Iskra repository), then rebuild whatever changed.
#   iskra-update          ports -u, then prt-get sysup (every update, built here)
#   iskra-update --dry    only show what would be rebuilt
# The kernel is a port too ("linux"); after it rebuilds, restart to use it.
set -e
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
echo "==> Iskra's own ports (git pull in /usr/src/iskra, checked and copied to /usr/ports/iskra)"
git -C /usr/src/iskra pull --ff-only
/usr/src/iskra/build/iskra-ports sync /usr/src/iskra
echo
echo "==> CRUX's ports (ports -u)"
ports -u
echo
if [ "${1:-}" = --dry ]; then
	prt-get diff
	exit 0
fi
echo "==> Rebuilding what changed (prt-get sysup; each build shows here)"
prt-get sysup
echo
echo "==> The CRUX handbook, for reading offline"
iskra-handbook update || true
echo
echo "Done. Anything new that was kept aside: sudo rejmerge"
