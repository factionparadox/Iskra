#!/bin/sh
# Update everything: Slackware -current and the other repositories (ready-made packages,
# nothing compiled), then anything sparkpkg built from an Arch or AUR recipe that has a newer one.
#   iskra-update          sparkpkg upgrade
#   iskra-update --dry    only show what would change
# A new kernel takes effect after a restart; GRUB's menu is remade for it on the way.
set -e
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
if [ "${1:-}" = --dry ]; then
	slpkg update
	slpkg upgrade -o all --dry-run
	echo
	echo "==> Recipes sparkpkg built that have newer versions"
	/usr/lib/sparkpkg/assimilate outdated | awk '{ printf "  %-28s %-5s %s -> %s\n", $1, $2, $3, $4 } END { if (!NR) print "  none" }'
	exit 0
fi
sparkpkg upgrade
echo
echo "==> The Slackware book, for reading offline"
iskra-handbook update || true
echo
new=$(find /etc -name '*.new' 2>/dev/null)
if [ -n "$new" ]; then
	echo "Updated settings files were kept aside, beside your own copies (compare, then keep one):"
	printf '  %s\n' $new
fi
echo "Done. Changed your mind?  sudo sparkpkg undo"
