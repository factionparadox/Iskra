#!/usr/bin/env python3
"""handbook-text OUT.txt CHAPTER.html...: the Slackware book as one plain-text file for less.

The chapters are docs.slackware.com's "slackbook" pages (a DokuWiki), each fetched with
?do=export_xhtml, given in the book's order. Only each page's text (div.dokuwiki) is kept:
headings, paragraphs wrapped at 78 columns, lists, tables and the command examples exactly as
they are. The table of contents, the "Chapter Navigation" links and the "Sources" section at the
end of each page are left out."""
import html.parser, re, sys, textwrap

SKIP_SECTIONS = ('chapter_navigation', 'sources')


class Page(html.parser.HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out, self.buf = [], []
        self.depth = 0          # <div> depth inside div.dokuwiki (0: outside)
        self.pre = 0
        self.skip = 0           # inside the table of contents or the tags
        self.done = False       # past the chapter's own text
        self.heading = None
        self.cells = None

    def flush(self, kind='p'):
        text = ''.join(self.buf); self.buf = []
        if self.pre:
            return
        text = re.sub(r'\s+', ' ', text).strip()
        if not text:
            return
        if kind == 'li':
            self.out.append(textwrap.fill(text, 78, initial_indent='  - ', subsequent_indent='    '))
        else:
            self.out.append(textwrap.fill(text, 78))

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if self.done:
            return
        if self.depth == 0:
            if tag == 'div' and 'dokuwiki' in (a.get('class') or '').split():
                self.depth = 1
            return
        if tag == 'div':
            self.depth += 1
            if a.get('id') == 'dw__toc' or 'tags' in (a.get('class') or '').split():
                self.skip = self.depth
        if self.skip:
            return
        if tag in ('h1', 'h2', 'h3', 'h4', 'h5'):
            self.flush()
            if a.get('id') in SKIP_SECTIONS:
                self.done = True
                return
            self.heading = tag
        elif tag in ('p', 'div', 'dt', 'dd'):
            self.flush()
        elif tag == 'br':
            self.buf.append('\n') if self.pre else self.flush()
        elif tag == 'li':
            self.flush()
        elif tag == 'pre':
            self.flush(); self.pre = 1
        elif tag == 'tr':
            self.flush(); self.cells = []
        elif tag in ('td', 'th') and self.cells is not None:
            self.buf = []

    def handle_endtag(self, tag):
        if self.depth == 0 or self.done:
            return
        if tag == 'div':
            if self.skip == self.depth:
                self.skip = 0
            self.depth -= 1
            if self.depth == 0:
                self.flush()
            return
        if self.skip:
            return
        if tag in ('h1', 'h2', 'h3', 'h4', 'h5') and self.heading:
            text = re.sub(r'\s+', ' ', ''.join(self.buf)).strip(); self.buf = []
            if text:
                if self.heading == 'h1':
                    self.out.append(text.upper() + '\n' + '=' * len(text))
                elif self.heading == 'h2':
                    self.out.append(text + '\n' + '-' * len(text))
                else:
                    self.out.append(text)
            self.heading = None
        elif tag == 'li':
            self.flush('li')
        elif tag == 'pre':
            code = ''.join(self.buf).strip('\n'); self.buf = []; self.pre = 0
            self.out.append('\n'.join('    ' + l for l in code.split('\n')))
        elif tag in ('td', 'th') and self.cells is not None:
            self.cells.append(re.sub(r'\s+', ' ', ''.join(self.buf)).strip()); self.buf = []
        elif tag == 'tr' and self.cells is not None:
            if any(self.cells):
                self.out.append('  ' + '  |  '.join(self.cells))
            self.cells = None
        elif tag in ('p', 'dt', 'dd'):
            self.flush()

    def handle_data(self, data):
        if self.depth and not self.skip and not self.done:
            self.buf.append(data)


def chapter(path):
    raw = open(path, 'rb').read()
    try:
        text = raw.decode('utf-8')
    except UnicodeDecodeError:
        text = raw.decode('iso-8859-1')
    if 'class="dokuwiki' not in text:
        sys.exit(f'handbook-text: {path} does not look like a page of the Slackware book')
    p = Page(); p.feed(text); p.flush()
    return '\n\n'.join(p.out).strip()


if len(sys.argv) < 3:
    sys.exit('usage: handbook-text OUT.txt CHAPTER.html...')
chapters = [c for c in (chapter(path) for path in sys.argv[2:]) if c]
book = ('SLACKWARE LINUX ESSENTIALS\n==========================\n\n'
        'The Slackware book, by Alan Hicks, Chris Lumens, David Cantrell and Logan Johnson,\n'
        'from https://docs.slackware.com/slackbook:start (its home: http://www.slackbook.org/).\n'
        'Kept offline by iskra-handbook. In less: / searches, n finds the next match, q quits.\n\n'
        + '\n\n\n'.join(chapters) + '\n')
if len(chapters) < 10 or len(book) < 100000 or 'installpkg' not in book:
    sys.exit('handbook-text: that does not look like the whole Slackware book '
             f'({len(chapters)} chapters, {len(book)} characters)')
open(sys.argv[1], 'w', encoding='utf-8').write(book)
