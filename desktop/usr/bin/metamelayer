#!/bin/sh
# metamelayer: Avalon's package manager, on Slackware -current. It speaks plain English over slpkg,
# which finds a ready-made package where one exists (Slackware's own, then AlienBOB's and
# conraid's) and otherwise builds one from Ponce's SlackBuilds, dependencies and all. Before
# anything changes, it takes a Btrfs snapshot, so any change can be undone from the boot menu.
#
#   metamelayer sync               fetch the repositories' latest package lists
#   metamelayer install NAME...    install, with what it needs (ready-made, or built from source)
#   metamelayer remove NAME...     remove
#   metamelayer upgrade            bring everything up to date (Slackware's and the others')
#   metamelayer search WORDS       look for a package, in every repository
#   metamelayer info NAME          what a package is, where it comes from, what it needs
#   metamelayer list               what's installed
#   metamelayer needs NAME         what a package depends on;  metamelayer used-by NAME: the reverse
#   metamelayer check              anything whose libraries have gone missing (and what to rebuild)
#   metamelayer hold NAME...       keep these as they are through upgrades;  unhold NAME...: let go
#   metamelayer held               what's held
#   metamelayer history            what was installed, upgraded and removed, and when
#   metamelayer snapshot [WHY]     a snapshot of the system now (one is taken before every change)
#   metamelayer snapshots          the snapshots, newest first
#   metamelayer rollback NAME      the system as it was in snapshot NAME, from the next start (your
#                                  files and logs stay as they are; it can be undone the same way)
#   metamelayer forget NAME...     delete snapshots
#   metamelayer log                the log of the last install or upgrade
set -e
SNAPSHOT=/usr/sbin/avalon-snapshot
LOG=/var/log/metamelayer.log
if [ -t 1 ]; then C=$(printf '\033['); else C=; fi   # colour on a terminal only
say() { printf '%s==>%s %s\n' "${C:+${C}1;36m}" "${C:+${C}0m}" "$*"; }
die() { printf '%smetamelayer:%s %s\n' "${C:+${C}1;35m}" "${C:+${C}0m}" "$*" >&2; exit 1; }
root() { [ "$(id -u)" = 0 ] || exec sudo "$0" "$CMD" "$@"; }
need_slpkg() { command -v slpkg >/dev/null || die "slpkg isn't installed (it comes with Avalon: sudo upgradepkg --install-new it from the stick)"; }
snap() { [ -x "$SNAPSHOT" ] && "$SNAPSHOT" take --auto "$@" || true; }
logged() { echo "== $(date '+%F %T') $*" >> "$LOG"; "$@" 2>&1 | tee -a "$LOG"; }

CMD=${1:-help}; [ $# -gt 0 ] && shift
case $CMD in
	sync)       root "$@"; need_slpkg; logged slpkg update -y ;;
	install|in) root "$@"; need_slpkg; [ $# -gt 0 ] || die "install what?"
	            snap "before install $*"; logged slpkg install -o all -y "$@" ;;
	remove|rm)  root "$@"; need_slpkg; [ $# -gt 0 ] || die "remove what?"
	            snap "before remove $*"; logged slpkg remove -y "$@" ;;
	upgrade|up) root "$@"; need_slpkg
	            say "The repositories' latest lists"; logged slpkg update -y
	            snap "before upgrade"
	            # no -y here: after a kernel update, slpkg's -y would also say yes to rebooting
	            say "Upgrading (Slackware's own first, then the others)"; slpkg upgrade -o all
	            say "Anything an upgrade left without its libraries"
	            slpkg check-broken || echo "    (rebuild each one listed above with:  sudo slpkg rebuild NAME)" ;;
	search|s)   need_slpkg; [ $# -gt 0 ] || die "search for what?"; exec slpkg search -o all "$@" ;;
	info)       need_slpkg; [ $# -gt 0 ] || die "info on what?"; exec slpkg info -o all "$@" ;;
	list|ls)    need_slpkg; exec slpkg list "$@" ;;
	needs)      need_slpkg; exec slpkg depends -o all "$@" ;;
	used-by)    need_slpkg; exec slpkg reverse "$@" ;;
	check)      need_slpkg; exec slpkg check-broken "$@" ;;
	hold)       root "$@"; need_slpkg; [ $# -gt 0 ] || die "hold what?"; exec slpkg pin "$@" ;;
	unhold)     root "$@"; need_slpkg; [ $# -gt 0 ] || die "unhold what?"; exec slpkg pin --unpin "$@" ;;
	held)       need_slpkg; exec slpkg pin ;;
	history)    need_slpkg; exec slpkg history "$@" ;;
	snapshot)   root "$@"; exec "$SNAPSHOT" take "$@" ;;
	snapshots)  exec "$SNAPSHOT" list ;;
	rollback)   root "$@"; exec "$SNAPSHOT" rollback "$@" ;;
	forget)     root "$@"; exec "$SNAPSHOT" forget "$@" ;;
	log)        exec "${PAGER:-less}" "$LOG" ;;
	help|-h|--help|*)
	            sed -n '2,/^set -e/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
	            [ "$CMD" = help ] || [ "$CMD" = -h ] || [ "$CMD" = --help ] || exit 2 ;;
esac
