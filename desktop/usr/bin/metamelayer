#!/usr/bin/env sh
exec guile --no-auto-compile -e main -s "$0" "$@"
!#
;;; metamelayer: nixpkgs for Avalon, for what Guix and Nonguix don't have. (HECTAS does Guix.)
;;;
;;; Nix is kept at arm's length: everything goes in your own Nix profile (~/.nix-profile), built by
;;; the Nix daemon Avalon runs; nothing touches the Guix system, /etc/config.scm or your Guix
;;; profile. The Garden System adds ~/.nix-profile to the PATH and the launcher.
;;;
;;;   metamelayer setup               once: the nixpkgs channel (nixpkgs-unstable)
;;;   metamelayer search WORDS…       find packages              metamelayer list
;;;   metamelayer install PACKAGE…    into your Nix profile      metamelayer remove PACKAGE…
;;;   metamelayer upgrade             update nixpkgs and upgrade everything from it
;;;   metamelayer run PACKAGE [ARGS…] run without installing     metamelayer shell PACKAGE…
;;;   metamelayer gl COMMAND…         run a Nix program that needs the graphics (through nixGL)
;;;   metamelayer rollback            your Nix profile's previous generation
;;;   metamelayer gc                  delete old Nix generations and what nothing uses
;;;
;;; Every command shows the nix command it runs.

(setlocale LC_ALL "")
(use-modules (ice-9 match) (ice-9 format) (ice-9 rdelim) (srfi srfi-1))

(define channel "https://nixos.org/channels/nixpkgs-unstable")
(define features '("--extra-experimental-features" "nix-command flakes"))

(define (say fmt . args)
  (format #t "~%\x1b[1;36m==> ~?\x1b[0m~%" fmt args)
  (force-output))
(define (fail fmt . args)
  (format (current-error-port) "\x1b[1;35mmetamelayer: ~?\x1b[0m~%" fmt args)
  (exit 1))
(define (run . args)
  (format #t "\x1b[2m$ ~a\x1b[0m~%" (string-join args " "))
  (force-output)
  (zero? (status:exit-val (apply system* args))))
(define (run! . args)
  (unless (apply run args) (exit 1)))
(define (needs what args)
  (when (null? args) (fail "~a ~a needs ~a" (basename (car (command-line))) (cadr (command-line)) what)))

(define (ready?)
  (and (zero? (status:exit-val (system* "sh" "-c" "command -v nix-env >/dev/null")))
       (zero? (status:exit-val (system* "sh" "-c" "nix-channel --list 2>/dev/null | grep -q '^nixpkgs '")))))

(define (setup)
  (unless (zero? (status:exit-val (system* "sh" "-c" "command -v nix-env >/dev/null")))
    (fail "Nix isn't here: Avalon's services run it (nix-service-type); hectas reconfigure"))
  (say "The nixpkgs channel")
  (run! "nix-channel" "--add" channel "nixpkgs")
  (run! "nix-channel" "--update")
  (say "Ready: metamelayer install PACKAGE"))

(define (need-ready)
  (unless (ready?) (setup)))

(define (main args)
  (match (cdr args)
    (("setup") (setup))
    (("search" . words)
     (needs "something to look for" words)
     (apply run! "nix" (append features (list "search" "nixpkgs") words)))
    (("install" . pkgs)
     (needs "a package" pkgs) (need-ready)
     (apply run! "nix-env" "-iA" (map (lambda (p) (string-append "nixpkgs." p)) pkgs))
     (format #t "~%In the launcher after your next log-in (or run it by name now).~%"))
    (("remove" . pkgs) (needs "a package" pkgs) (apply run! "nix-env" "-e" pkgs))
    (("upgrade") (need-ready) (run! "nix-channel" "--update") (run! "nix-env" "-u"))
    (("list") (run! "nix-env" "-q"))
    (("run" pkg . rest)
     (need-ready)
     (run! "nix-shell" "-p" pkg "--run" (string-join (cons pkg rest) " ")))
    (("shell" . pkgs) (needs "a package" pkgs) (need-ready) (apply run! "nix-shell" "-p" pkgs))
    (("gl" . cmd)
     (needs "a command" cmd)
     (apply run! "nix" (append features (list "run" "--impure" "github:nix-community/nixGL" "--") cmd)))
    (("rollback") (run! "nix-env" "--rollback"))
    (("gc") (run! "nix-collect-garbage" "-d"))
    (_ (let ((port (open-input-file (car args) #:encoding "UTF-8")))
         (let loop ((line (read-line port)))
           (unless (eof-object? line)
             (when (string-prefix? ";;;" line)
               (display (string-drop line (min 4 (string-length line))))
               (newline))
             (loop (read-line port))))
         (exit 2)))))
