#!/bin/sh
# metamelayer: Avalon's package manager, over CRUX's own tools (prt-get, pkgmk, pkgutils).
#
#   metamelayer sync               update the ports: CRUX's collections and Avalon's
#   metamelayer install NAME...    build and install, with what they depend on
#   metamelayer remove NAME...     remove
#   metamelayer upgrade            sync, then rebuild whatever is out of date
#   metamelayer search WORD        find ports by name
#   metamelayer info NAME          what a port is and what it needs
#   metamelayer list               what's installed
#   metamelayer diff               installed packages with newer ports
#   metamelayer key                make your own signing key for Avalon's ports (once)
#   metamelayer sign [NAME...]     sign Avalon's ports with your key (all, or the ones named)
#   metamelayer gentoo [CMD...]    the escape hatch: Gentoo with Portage in /var/lib/gentoo
#                                  (a shell there; or: emerge ARGS, sync, run PROGRAM, update)
#
# Avalon's ports are signed by you: the key lives in /etc/ports/avalon.{pub,sec} on this
# machine and nowhere else, and pkgmk refuses a port whose files don't match its signature.
set -e
AVALON=${AVALON_SRC:-/usr/ports/avalon}
PORTS=$AVALON/ports
KEY=/etc/ports/avalon

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;35mmetamelayer:\033[0m %s\n' "$*" >&2; exit 1; }
root() { [ "$(id -u)" = 0 ] || die "this needs root: sudo metamelayer $*"; }

sync_ports() {
	say "CRUX's ports"
	ports -u
	if [ -d "$AVALON/.git" ]; then
		say "Avalon's ports ($AVALON)"
		git -C "$AVALON" pull --ff-only
		[ -f "$KEY.sec" ] && sign_ports
	fi
	return 0
}

make_key() {
	root key
	[ -f "$KEY.sec" ] && { echo "You already have a key: $KEY.pub"; return 0; }
	install -d -m 755 /etc/ports
	# signify wants both names bare, in the same folder (keyname.pub and keyname.sec)
	( cd "$(dirname "$KEY")" && signify -G -n -c "Avalon ports, signed on $(hostname)" \
		-p "$(basename "$KEY").pub" -s "$(basename "$KEY").sec" )
	chmod 600 "$KEY.sec"
	say "Your key: $KEY.pub (the secret half, $KEY.sec, never leaves this machine)"
}

sign_ports() {
	[ -f "$KEY.sec" ] || die "no key yet: sudo metamelayer key"
	if [ $# -eq 0 ]; then set -- $(ls "$PORTS"); fi
	for p in "$@"; do
		[ -f "$PORTS/$p/Pkgfile" ] || continue
		( cd "$PORTS/$p" && pkgmk -d -us -sk "$KEY.sec" >/dev/null ) && echo "    signed $p" ||
			echo "    could not sign $p (its sources didn't download?)"
	done
}

 # Gentoo lives in its own root, /var/lib/gentoo, so Portage and CRUX never overwrite each
# other's files. It shares /home, /run and the devices, so its programs can open windows here.
G=/var/lib/gentoo
gentoo() {
	root gentoo
	[ -x $G/usr/bin/emerge ] || die "no Gentoo in $G (the Avalon disc puts it there)"
	grep -q " $G/proc " /proc/mounts || {
		mount -t proc proc $G/proc
		mount --rbind /sys $G/sys && mount --make-rslave $G/sys
		mount --rbind /dev $G/dev && mount --make-rslave $G/dev
		mount --bind /run $G/run
		mount --bind /home $G/home
		mount -t tmpfs tmpfs $G/tmp
		mount --bind /tmp/.X11-unix $G/tmp/.X11-unix 2>/dev/null || true
	}
	cp -L /etc/resolv.conf $G/etc/resolv.conf
	u=${SUDO_USER:-}
	if [ -n "$u" ] && ! grep -q "^$u:" $G/etc/passwd; then   # you, inside Gentoo too
		grep "^$u:" /etc/passwd >> $G/etc/passwd
		grep "^$u:" /etc/shadow >> $G/etc/shadow
		g=$(id -gn "$u"); grep -q "^$g:" $G/etc/group || grep "^$g:" /etc/group >> $G/etc/group
	fi
	in_g() { chroot $G /usr/bin/env -i HOME=/root TERM="${TERM:-linux}" PATH=/usr/sbin:/usr/bin:/sbin:/bin "$@"; }
	case ${1:-} in
		"")     say "Gentoo (Portage). 'exit' to come back to Avalon"; in_g /bin/bash -l ;;
		emerge) shift; in_g emerge --getbinpkg "$@" ;;
		sync)   in_g emerge --sync || in_g emerge-webrsync ;;
		update) in_g emerge --sync; in_g emerge --getbinpkg -uDN @world ;;
		run)    shift; [ -n "$u" ] || die "run it with sudo, as yourself"
			rt=/run/user/$(id -u "$u")
			wl=$(ls "$rt" 2>/dev/null | grep -m1 '^wayland-[0-9]*$' || echo wayland-0)
			in_g su - "$u" -c "export WAYLAND_DISPLAY=$wl XDG_RUNTIME_DIR=$rt; $*" ;;
		*)      in_g "$@" ;;
	esac
}

[ $# -ge 1 ] || { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
cmd=$1; shift
case $cmd in
	sync)            root sync; sync_ports ;;
	install|in)      root install; exec prt-get depinst "$@" ;;
	remove|rm)       root remove; exec prt-get remove "$@" ;;
	upgrade|up)      root upgrade; sync_ports; exec prt-get sysup ;;
	search|s)        exec prt-get search "$@" ;;
	info)            exec prt-get info "$@" ;;
	list|ls)         exec prt-get listinst ;;
	diff)            exec prt-get diff ;;
	key)             make_key ;;
	sign)            root sign; sign_ports "$@" ;;
	gentoo|portage)  gentoo "$@" ;;
	*)               die "unknown command '$cmd' (metamelayer with no arguments lists them)" ;;
esac
