#!/bin/bash
# metamelayer: Avalon's package manager. Avalon is an image (Universal Blue, Fedora's bootc
# images): the system is read-only and replaced whole by each update, and the one before stays
# a restart away. Metamelayer builds that image here, on this laptop, from Avalon's repository.
#
#   metamelayer update             fetch Avalon, build the new image here, switch to it, update
#                                  Flatpaks; the new system starts at the next restart
#   metamelayer rollback           go back to the previous system (at the next restart)
#   metamelayer status             which system is running, which is staged, which is behind
#   metamelayer add PKG...         add Fedora packages on top of the image (rpm-ostree)
#   metamelayer drop PKG...        remove ones you added
#   metamelayer search WORD        find Fedora packages
#   metamelayer flatpak install|remove|update|list|search [APP]   Flathub (e.g. org.vinegarhq.Sober)
#   metamelayer box [NAME] [CMD]   a mutable Fedora (or other) container, for trying things
#   metamelayer gentoo [CMD...]    the escape hatch: Gentoo with Portage, in a container
#                                  (a shell; or: emerge ARGS, export PROGRAM)
#
# Packages you want for good belong in the image: add them to build/image/packages in Avalon's
# repository (/var/lib/avalon/repo, or your own fork) and run metamelayer update.
set -e
REPO=${AVALON_REPO:-/var/lib/avalon/repo}
UPSTREAM=${AVALON_UPSTREAM:-https://github.com/factionparadox/Iskra}
IMAGE=localhost/avalon:latest

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;35mmetamelayer:\033[0m %s\n' "$*" >&2; exit 1; }
root() { [ "$(id -u)" = 0 ] || exec sudo "$0" "$CMD" "$@"; }

booted_image() {   # the image the running system came from
	bootc status --format=json 2>/dev/null | python3 -c '
import sys, json
s = json.load(sys.stdin).get("status", {}).get("booted") or {}
print(((s.get("image") or {}).get("image") or {}).get("image", ""))' 2>/dev/null
}

update() {
	say "Avalon's repository ($REPO)"
	if [ -d "$REPO/.git" ]; then git -C "$REPO" pull --ff-only
	else mkdir -p "$(dirname "$REPO")"; git clone "$UPSTREAM" "$REPO"; fi
	git -C "$REPO" log --oneline -1

	say "Building the Avalon image here (Universal Blue's base, then Avalon on top)"
	podman build --pull=newer -t "$IMAGE" -f "$REPO/Containerfile" "$REPO"

	say "Switching to it (the new system starts at the next restart; the old one stays one restart away)"
	if [ "$(booted_image)" = "$IMAGE" ]; then bootc upgrade
	else bootc switch --transport containers-storage "$IMAGE"; fi

	if command -v flatpak >/dev/null; then say "Flatpaks"; flatpak update -y --noninteractive || true; fi
	podman image prune -f >/dev/null 2>&1 || true
	say "Done. Restart when you're ready:  systemctl reboot"
}

flat() {
	local verb=${1:-list}; shift || true
	case $verb in
		install|in) flatpak install -y flathub "$@" ;;
		remove|rm)  flatpak uninstall -y "$@" ;;
		update|up)  flatpak update -y ;;
		list|ls)    flatpak list --app ;;
		search|s)   flatpak search "$@" ;;
		*)          die "flatpak: install, remove, update, list or search" ;;
	esac
}

gentoo() {
	# Portage, in a distrobox: Gentoo's own userland in a container that shares your home,
	# so it can never touch Avalon's files. emerge uses Gentoo's prebuilt packages first.
	command -v distrobox >/dev/null || die "distrobox isn't installed"
	if ! distrobox list 2>/dev/null | grep -q ' gentoo '; then
		say "Making the Gentoo box (once): Gentoo's stage3, with Portage"
		distrobox create -Y --name gentoo --image docker.io/gentoo/stage3:latest \
			--init-hooks 'grep -q getbinpkg /etc/portage/make.conf || echo FEATURES=\"\${FEATURES} getbinpkg\" >> /etc/portage/make.conf; [ -d /var/db/repos/gentoo/metadata ] || emerge-webrsync -q'
	fi
	case ${1:-} in
		"")     distrobox enter gentoo ;;
		emerge) shift; distrobox enter gentoo -- sudo emerge --getbinpkg "$@" ;;
		export) shift; distrobox enter gentoo -- distrobox-export --app "$1" ;;
		*)      distrobox enter gentoo -- "$@" ;;
	esac
}

CMD=${1:-}; shift || true
case $CMD in
	update|up|upgrade) root "$@"; update ;;
	rollback)          root "$@"; bootc rollback; say "The previous system starts at the next restart" ;;
	status|st)         bootc status 2>/dev/null || rpm-ostree status ;;
	add)               root "$@"; [ $# -gt 0 ] || die "add what?"; rpm-ostree install --idempotent "$@"
	                   say "Added; they arrive at the next restart (or now: sudo rpm-ostree apply-live)" ;;
	drop)              root "$@"; [ $# -gt 0 ] || die "drop what?"; rpm-ostree uninstall "$@" ;;
	search|s)          [ $# -gt 0 ] || die "search for what?"; dnf search "$@" ;;
	flatpak|fp)        flat "$@" ;;
	box)               name=${1:-fedora}; shift || true
	                   distrobox list 2>/dev/null | grep -q " $name " || distrobox create -Y --name "$name"
	                   distrobox enter "$name" ${1:+-- "$@"} ;;
	gentoo|portage)    gentoo "$@" ;;
	""|help|-h)        sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
	*)                 die "unknown command '$CMD' (metamelayer help lists them)" ;;
esac
