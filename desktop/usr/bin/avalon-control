#!/usr/bin/env python3
"""Avalon Control: Avalon's settings, in GTK4, dressed as the Garden System.

    avalon-control [PAGE]      PAGE: appearance display sound network bluetooth power keyboard
                                     neredy updates nix about     (Super+, opens it)

It changes things with the same tools you would use by hand, so nothing is hidden:
  Mango's look and keyboard   ~/.config/mango/config.conf (a copy of /etc/mango/config.conf with
                              your changes; "Avalon's defaults" deletes it), then mmsg reload
  wallpaper                   ~/.config/avalon/wallpaper (a link to your picture)
  brightness, night light     brightnessctl, wlsunset
  sound                       wpctl (PipeWire)
  network, Bluetooth          nmcli, bluetoothctl
  battery charge limit        sudo avalon-power charge-limit N (asks for your password, in kitty)
  Neredy, updates, Nix        neredy, hectas (Guix), metamelayer (Nix): long jobs open in kitty
"""
import os
import re
import shutil
import subprocess
import sys
import threading
from pathlib import Path

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

HOME = Path.home()
MANGO_SYSTEM = Path('/etc/mango/config.conf')
MANGO_USER = HOME / '.config/mango/config.conf'
WALLPAPER = HOME / '.config/avalon/wallpaper'
GARDEN_WALLPAPER = Path('/usr/share/avalon/garden-wallpaper.png')
PORTRAIT = Path('/usr/share/avalon/pasha-portrait.png')
GLYPHS = ['土', '水', '風', '火']

CSS = """
