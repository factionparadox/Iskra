#!/usr/bin/env python3
"""metamelayer-deps: what installed packages actually need, read from their programs.

Like NuTyX's CARDS, it doesn't trust the "# Depends on:" lines alone: it opens every program and
library a package installed, reads the shared libraries each one asks for (the ELF dynamic
section: DT_NEEDED, with RPATH/RUNPATH), finds the file the system would load for each, and the
package that owns that file (from pkgutils' database).

    metamelayer-deps deps  NAME...   each package's runtime dependencies, as found; and what its
                                     Pkgfile's "Depends on" misses (CRUX leaves core out of those
                                     lines, so core packages aren't counted as missing)
    metamelayer-deps check [NAME...] packages with a library that can't be found: broken, usually
                                     by an update to a library they were built against. Prints
                                     their names, one per line, in an order to rebuild them in;
                                     exits 1 if there are any
    metamelayer-deps explain NAME    for each broken file in a package: which library is missing
    metamelayer-deps arch NAME...    before building: what Arch Linux's package (or the AUR's) says
                                     NAME needs to run and to build, matched to CRUX's ports: which
                                     are there, which have no port yet, and what the Pkgfile misses
    metamelayer-deps new NAME DIR    a first Pkgfile for a new port in DIR/NAME, filled in from
                                     Arch's package (description, URL, version, dependencies
                                     matched to CRUX's ports, and a build() for its build system)

Runtime dependencies found by `deps` are kept in /var/lib/avalon/rdeps/NAME.
Only reads (apart from `new`, which writes one new Pkgfile): it never changes the system (metamelayer does the rebuilding).
"""
import os
import re
import signal
import struct
import subprocess
import sys

DB = os.environ.get('METAMELAYER_DB', '/var/lib/pkg/db')
RDEPS = os.environ.get('METAMELAYER_RDEPS', '/var/lib/avalon/rdeps')
DEFAULT_DIRS = ['/lib', '/usr/lib', '/lib64', '/usr/lib64']

# ---- ELF: just enough to read the dynamic section -----------------------------------------

DT_NEEDED, DT_STRTAB, DT_RPATH, DT_RUNPATH = 1, 5, 15, 29
PT_LOAD, PT_DYNAMIC = 1, 2


def elf_needs(path):
    """(needed sonames, search dirs from RPATH/RUNPATH, elf class) or None if not a dynamic ELF"""
    try:
        with open(path, 'rb') as f:
            head = f.read(64)
            if len(head) < 52 or head[:4] != b'\x7fELF':
                return None
            cls, data = head[4], head[5]
            end = '<' if data == 1 else '>'
            if cls == 2:
                phoff, = struct.unpack_from(end + 'Q', head, 32)
                phentsize, phnum = struct.unpack_from(end + 'HH', head, 54)
                phfmt, dynfmt = end + 'IIQQQQQQ', end + 'qQ'
            elif cls == 1:
                phoff, = struct.unpack_from(end + 'I', head, 28)
                phentsize, phnum = struct.unpack_from(end + 'HH', head, 42)
                phfmt, dynfmt = end + 'IIIIIIII', end + 'iI'
            else:
                return None
            f.seek(phoff)
            ph = f.read(phentsize * phnum)
            loads, dyn = [], None
            for i in range(phnum):
                e = struct.unpack_from(phfmt, ph, i * phentsize)
                if cls == 2:
                    p_type, _flags, p_offset, p_vaddr, _pa, p_filesz, _memsz, _align = e
                else:
                    p_type, p_offset, p_vaddr, _pa, p_filesz, _memsz, _flags, _align = e
                if p_type == PT_LOAD:
                    loads.append((p_vaddr, p_offset, p_filesz))
                elif p_type == PT_DYNAMIC:
                    dyn = (p_offset, p_filesz)
            if not dyn:
                return None                       # static, or not a program/library
            f.seek(dyn[0])
            raw = f.read(dyn[1])
            step = struct.calcsize(dynfmt)
            needed, rpath, runpath, strtab = [], None, None, None
            for i in range(0, len(raw) - step + 1, step):
                tag, val = struct.unpack_from(dynfmt, raw, i)
                if tag == 0:
                    break
                if tag == DT_NEEDED:
                    needed.append(val)
                elif tag == DT_STRTAB:
                    strtab = val
                elif tag == DT_RPATH:
                    rpath = val
                elif tag == DT_RUNPATH:
                    runpath = val
            if strtab is None:
                return None
            off = next((o + strtab - v for v, o, s in loads if v <= strtab < v + s), None)
            if off is None:
                return None

            def string(i):
                f.seek(off + i)
                b = f.read(4096)
                return b[:b.index(b'\0')].decode('utf-8', 'replace') if b'\0' in b else b.decode('utf-8', 'replace')
            dirs = []
            for p in (runpath if runpath is not None else rpath,):
                if p is not None:
                    origin = os.path.dirname(os.path.realpath(path))
                    for d in string(p).split(':'):
                        if d:
                            dirs.append(d.replace('$ORIGIN', origin).replace('${ORIGIN}', origin))
            return [string(n) for n in needed], dirs, cls
    except (OSError, struct.error, ValueError):
        return None


# ---- the system: who owns what, where libraries are ---------------------------------------

def read_db():
    owner, files = {}, {}
    try:
        text = open(DB, encoding='utf-8', errors='replace').read()
    except OSError:
        sys.exit(f'metamelayer-deps: can\'t read {DB} (is this CRUX?)')
    for block in text.split('\n\n'):
        lines = block.strip('\n').split('\n')
        if len(lines) < 2:
            continue
        name = lines[0]
        fl = ['/' + l for l in lines[2:] if l and not l.endswith('/')]
        files[name] = fl
        for p in fl:
            owner.setdefault(p, name)
    return owner, files


def ld_cache():
    """soname → paths, from the dynamic linker's cache (and the default directories)"""
    cache = {}
    try:
        out = subprocess.run(['ldconfig', '-p'], capture_output=True, text=True).stdout
        for line in out.splitlines():
            m = re.match(r'\s+(\S+) \(([^)]*)\) => (\S+)', line)
            if m:
                cache.setdefault(m.group(1), []).append((m.group(3), 'x86-64' in m.group(2)))
    except OSError:
        pass
    return cache


class System:
    def __init__(self):
        self.owner, self.files = read_db()
        self.cache = ld_cache()

    def find(self, soname, dirs, cls):
        if '/' in soname:
            return soname if os.path.exists(soname) else None
        for d in dirs:
            p = os.path.join(d, soname)
            if os.path.exists(p):
                return p
        for p, is64 in self.cache.get(soname, []):
            if is64 == (cls == 2) and os.path.exists(p):
                return p
        for d in DEFAULT_DIRS:
            p = os.path.join(d, soname)
            if os.path.exists(p):
                return p
        return None

    def owner_of(self, path):
        o = self.owner.get(path)
        if o is None:
            o = self.owner.get(os.path.realpath(path))
        return o

    def scan(self, name):
        """(runtime deps, {file: [missing sonames]}) for an installed package"""
        deps, broken = set(), {}
        for p in self.files.get(name, []):
            if not os.path.isfile(p) or os.path.islink(p):
                continue
            r = elf_needs(p)
            if r is None:
                continue
            needed, dirs, cls = r
            for so in needed:
                lib = self.find(so, dirs, cls)
                if lib is None:
                    broken.setdefault(p, []).append(so)
                    continue
                o = self.owner_of(lib)
                if o and o != name:
                    deps.add(o)
        return deps, broken


# ---- ports: what the Pkgfiles say ---------------------------------------------------------

def prtdirs():
    dirs = []
    try:
        for line in open('/etc/prt-get.conf'):
            m = re.match(r'\s*prtdir\s+(\S+)', line)
            if m:
                dirs.append(m.group(1).split(':')[0])
    except OSError:
        pass
    return dirs or ['/usr/ports/core', '/usr/ports/opt', '/usr/ports/xorg', '/usr/ports/contrib']


def declared(name):
    for d in prtdirs():
        f = os.path.join(d, name, 'Pkgfile')
        if os.path.isfile(f):
            for line in open(f, encoding='utf-8', errors='replace'):
                m = re.match(r'#\s*Depends on:\s*(.*)', line)
                if m:
                    return set(m.group(1).replace(',', ' ').split()), f
            return set(), f
    return None, None


def core_packages():
    try:
        return set(os.listdir('/usr/ports/core'))
    except OSError:
        return set()


# ---- commands -----------------------------------------------------------------------------

def cmd_deps(names):
    s = System()
    core = core_packages()
    try:
        os.makedirs(RDEPS, exist_ok=True)
    except OSError:
        pass
    missing_any = False
    for name in names:
        if name not in s.files:
            print(f'{name}: not installed')
            continue
        deps, broken = s.scan(name)
        print(f'{name}: needs {" ".join(sorted(deps)) or "(nothing beyond itself)"}')
        try:
            with open(os.path.join(RDEPS, name), 'w') as f:
                f.write('\n'.join(sorted(deps)) + '\n')
        except OSError:
            pass
        want, pkgfile = declared(name)
        if want is not None:
            missing = sorted(deps - want - core)
            if missing:
                missing_any = True
                print(f'  ! its Pkgfile ({pkgfile}) doesn\'t list: {" ".join(missing)}')
        for f, sos in broken.items():
            print(f'  ! {f} can\'t find {", ".join(sos)}')
    return 2 if missing_any else 0


def cmd_check(names):
    s = System()
    pool = names or sorted(s.files)
    broken = {}
    deps_of = {}
    for name in pool:
        deps, b = s.scan(name)
        deps_of[name] = deps
        if b:
            broken[name] = b
    # rebuild order: a broken package after any broken package it depends on
    order, seen = [], set()

    def visit(n, stack=()):
        if n in seen or n in stack:
            return
        for d in sorted(deps_of.get(n, ())):
            if d in broken:
                visit(d, stack + (n,))
        seen.add(n)
        order.append(n)
    for n in sorted(broken):
        visit(n)
    for n in order:
        print(n)
    return 1 if order else 0


def cmd_explain(names):
    s = System()
    for name in names:
        _deps, broken = s.scan(name)
        if not broken:
            print(f'{name}: nothing missing')
        for f, sos in broken.items():
            print(f'{name}: {f} can\'t find {", ".join(sos)}')
    return 0


# ---- Arch's package data: what a package needs, before it's built ------------------------

import json
import urllib.parse
import urllib.request

ARCH = 'https://archlinux.org/packages/search/json/?name='
AUR = 'https://aur.archlinux.org/rpc/v5/info?arg[]='
# Arch names that CRUX spells differently (checked against the ports before being used)
RENAMES = {'python': 'python3', 'freetype2': 'freetype', 'libgl': 'libglvnd', 'sh': 'bash',
           'python-gobject': 'python3-gobject', 'wlroots0.20': 'wlroots', 'wlroots0.19': 'wlroots',
           'gcc-libs': 'gcc', 'glib2': 'glib', 'pcre2': 'libpcre2', 'pcre': 'libpcre', 'libgcc': 'gcc', 'libstdc++': 'gcc', 'pam': 'linux-pam',
           'libxkbcommon-x11': 'libxkbcommon', 'libpipewire': 'pipewire', 'libpulse': 'pulseaudio', 'xorg-server-xwayland': 'xorg-xwayland',
           'systemd-libs': None, 'systemd': None}


def same_project(a, b, name):
    """do two homepages look like the same project? Different accounts on the same kind of forge
    (GitHub, GitLab, Codeberg...) are different projects; otherwise the name in both is enough"""
    pa, pb = urllib.parse.urlparse(a), urllib.parse.urlparse(b)
    forges = ('github.com', 'gitlab.com', 'codeberg.org', 'sr.ht', 'git.sr.ht', 'bitbucket.org')
    ha, hb = pa.netloc.lower().removeprefix('www.'), pb.netloc.lower().removeprefix('www.')
    if ha in forges and hb in forges:
        oa = pa.path.strip('/').split('/')[:1]
        ob = pb.path.strip('/').split('/')[:1]
        return oa == ob
    key = name.lower().split('-')[0]
    return ha == hb or (key in a.lower() and key in b.lower())


def fetch_json(url):
    req = urllib.request.Request(url, headers={'User-Agent': 'metamelayer (Avalon, CRUX)'})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def pkgfile_field(name, field):
    _w, f = declared(name)
    if f:
        for line in open(f, encoding='utf-8', errors='replace'):
            m = re.match(r'#\s*' + field + r':\s*(\S+)', line)
            if m:
                return m.group(1)
    return ''


def arch_lookup(name, url=''):
    """Arch's (or the AUR's) record for name: dict with source, version, url, depends, makedepends.
    Arch may call it something else: a Pkgfile's "# Arch: NAME" line says so; failing that, the
    name with wm/wc, then a search for the name, kept only if the homepage is the same project."""
    tries = [pkgfile_field(name, 'Arch')] if pkgfile_field(name, 'Arch') else []
    tries += [name, name + 'wm', name + 'wc']
    if name.startswith('python3-'):
        tries.append('python-' + name[8:])
    found = arch_exact(tries, url, name)
    if found is not None:
        return found
    if url:                                           # by homepage: a search for the name
        try:
            for r in fetch_json('https://archlinux.org/packages/search/json/?q=' + urllib.parse.quote(name)).get('results', []):
                if same_project(url, r.get('url', ''), name) and urllib.parse.urlparse(url).netloc == urllib.parse.urlparse(r.get('url', '')).netloc:
                    return arch_record(r)
        except (OSError, ValueError):
            pass
    return arch_exact([name], '', name)                 # whatever has the name, for the "different project" note


def arch_record(r):
    return {'from': f"Arch ({r['repo']})", 'name': r['pkgname'], 'version': r['pkgver'], 'url': r.get('url', ''),
            'desc': r.get('pkgdesc', ''), 'depends': r.get('depends', []), 'makedepends': r.get('makedepends', [])}


def arch_exact(tries, url, name):
    """the first of tries that Arch (stable repositories first) or the AUR has, and that (when
    there's a homepage to compare) is the same project"""
    for n in tries:
        try:
            hits = [r for r in fetch_json(ARCH + urllib.parse.quote(n)).get('results', []) if r.get('pkgname') == n]
            hits.sort(key=lambda r: 'testing' in r.get('repo', ''))
            for r in hits:
                if not url or same_project(url, r.get('url', ''), name):
                    return arch_record(r)
            for r in fetch_json(AUR + urllib.parse.quote(n)).get('results', []):
                if not url or same_project(url, r.get('URL') or '', name):
                    return {'from': 'the AUR', 'name': r['Name'], 'version': r['Version'], 'url': r.get('URL') or '',
                            'desc': r.get('Description') or '', 'depends': r.get('Depends') or [],
                            'makedepends': r.get('MakeDepends') or []}
        except (OSError, ValueError) as e:
            return {'error': str(e)}
    return None


def all_ports():
    ports = {}
    for d in prtdirs():
        try:
            for n in os.listdir(d):
                if os.path.isfile(os.path.join(d, n, 'Pkgfile')):
                    ports.setdefault(n, os.path.basename(d.rstrip('/')))
        except OSError:
            pass
    return ports


def crux_name(dep, ports, s, provider_of_lib):
    """an Arch dependency → (CRUX port or None, note)"""
    dep = re.split(r'[<>=]', dep, maxsplit=1)[0] if '.so' not in dep else dep
    if '.so' in dep:                                  # a library: who provides it on this system?
        lib, _, ver = dep.partition('=')
        major = ver.split('-')[0]
        for cand in ([f'{lib}.{major}'] if major else []) + [lib]:
            owner = provider_of_lib(cand)
            if owner:
                return owner, f'{lib} (installed, from {owner})'
        return None, f'{lib} (a library nothing installed provides yet)'
    if dep in ports:
        return dep, dep
    alt = RENAMES.get(dep, dep.replace('python-', 'python3-', 1) if dep.startswith('python-') else dep)
    if alt is None:
        return None, f'{dep} (systemd: CRUX goes without)'
    for cand in (alt, 'xorg-' + alt, 'xorg-lib' + alt):   # CRUX's X libraries are xorg-…
        if cand in ports:
            return cand, f'{dep} → {cand}'
    return None, dep


def cmd_arch(names):
    ports = all_ports()
    core = core_packages()
    s = System()

    def provider_of_lib(soname):
        p = s.find(soname, [], 2)
        return s.owner_of(p) if p else None

    worst = 0
    for name in names:
        a = arch_lookup(name, pkgfile_field(name, 'URL'))
        if a is None:
            print(f'{name}: not in Arch or the AUR; its "Depends on" line is up to you (and metamelayer deps checks it once built)')
            continue
        if 'error' in a:
            print(f'{name}: couldn\'t reach Arch ({a["error"]})')
            worst = max(worst, 1)
            continue
        print(f'{name}: {a["from"]} has {a["name"]} {a["version"]}: {a["desc"]}')
        want, pkgfile = declared(name)
        url = ''
        if pkgfile:
            for line in open(pkgfile, encoding='utf-8', errors='replace'):
                m = re.match(r'#\s*URL:\s*(\S+)', line)
                if m:
                    url = m.group(1)
        if url and a['url']:
            if not same_project(url, a['url'], name):
                print(f'  ? not the same project: Arch\'s is {a["url"]}, the Pkgfile\'s is {url}; nothing to compare')
                continue
        missing_ports, run_ports = [], set()
        for label, deps in (('to run', a['depends']), ('to build', a['makedepends'])):
            have, lack = [], []
            for d in deps:
                port, note = crux_name(d, ports, s, provider_of_lib)
                if port == name or (port is None and d.startswith(a['name'] + '-')):
                    continue                         # its own split packages
                if port:
                    have.append(note if note != port else port)
                    if label == 'to run':
                        run_ports.add(port)
                else:
                    lack.append(note)
            print(f'  {label}: {" ".join(have) or "-"}')
            if lack:
                print(f'    no CRUX port: {" ".join(lack)}')
                missing_ports += lack
        if want is not None:
            # what the Pkgfile brings in, following each dependency's own "Depends on" (as prt-get does)
            reach, todo = set(), list(want)
            while todo:
                d = todo.pop()
                if d in reach:
                    continue
                reach.add(d)
                more, _f = declared(d)
                todo += list(more or ())
            need = run_ports | {crux_name(d, ports, s, provider_of_lib)[0] for d in a['makedepends']}
            miss = sorted(need - reach - core - {None, name})
            if miss:
                print(f'  ! its Pkgfile ({pkgfile}) doesn\'t list: {" ".join(miss)}')
                worst = max(worst, 2)
        if missing_ports:
            print('    (each needs a Pkgfile in Avalon\'s ports before this can build)')
            worst = max(worst, 2)
    return worst


BUILD_TOOLS = {'meson', 'ninja', 'cmake', 'make', 'pkgconf', 'pkg-config', 'gcc', 'git', 'autoconf',
               'automake', 'libtool', 'python-build', 'python-installer', 'python-wheel',
               'python-setuptools', 'rust', 'cargo', 'go'}

BUILDS = {
    'meson': '''  meson setup $name-$version build \\
    --prefix=/usr \\
    --buildtype=plain \\
    --wrap-mode nodownload
  meson compile -C build
  DESTDIR=$PKG meson install -C build''',
    'cmake': '''  cmake -S $name-$version -B build -G Ninja \\
    -D CMAKE_INSTALL_PREFIX=/usr \\
    -D CMAKE_INSTALL_LIBDIR=lib \\
    -D CMAKE_BUILD_TYPE=Release
  cmake --build build
  DESTDIR=$PKG cmake --install build''',
    'python': '''  cd $name-$version
  /usr/bin/python3 -m build --wheel --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl''',
    'cargo': '''  cd $name-$version
  cargo build --release --locked
  install -Dm755 target/release/$name $PKG/usr/bin/$name''',
    'configure': '''  cd $name-$version
  ./configure --prefix=/usr
  make
  make DESTDIR=$PKG install''',
}


def cmd_new(name, dest):
    """a first Pkgfile for a new port, filled in from Arch's package where there is one"""
    target = os.path.join(dest, name)
    if os.path.exists(os.path.join(target, 'Pkgfile')):
        print(f'new: {target}/Pkgfile already exists')
        return 2
    a = arch_lookup(name)
    if a is not None and 'error' in a:
        print(f'new: couldn\'t reach Arch ({a["error"]}); writing a blank Pkgfile')
        a = None
    ports, core, s = all_ports(), core_packages(), System()

    def provider_of_lib(soname):
        p = s.find(soname, [], 2)
        return s.owner_of(p) if p else None

    deps, lacking = [], []
    mk = set(a['makedepends']) if a else set()
    for d in (a['depends'] + a['makedepends']) if a else []:
        bare = re.split(r'[<>=]', d, maxsplit=1)[0]
        if bare in BUILD_TOOLS and bare not in a['depends']:
            continue
        port, note = crux_name(d, ports, s, provider_of_lib)
        if port is None and '.so' in d:              # libfoo.so with nothing installed: a port named foo?
            base = d.split('.so')[0]
            port = next((c for c in (base, base[3:]) if c in ports), None)
        if port is None:
            if not d.startswith(a['name'] + '-') and 'systemd' not in note:
                lacking.append(note)
        elif port not in core and port != name and port not in deps:
            deps.append(port)
    kind = ('meson' if 'meson' in mk else 'cmake' if 'cmake' in mk else
            'python' if 'python-build' in mk else 'cargo' if {'rust', 'cargo'} & mk else 'configure')
    version = re.sub(r'^\d+:', '', a['version']).rsplit('-', 1)[0] if a else '0'
    lines = [f'# Description: {a["desc"] if a else "TODO: what it is, in a line"}',
             f'# URL: {a["url"] if a else "TODO"}',
             '# Maintainer: Avalon',
             f'# Depends on: {" ".join(deps)}']
    if a and a['name'] != name:
        lines.append(f'# Arch: {a["name"]}')
    lines += ['']
    if a:
        where = ('https://aur.archlinux.org/cgit/aur.git/tree/PKGBUILD?h=' if a['from'] == 'the AUR'
                 else 'https://gitlab.archlinux.org/archlinux/packaging/packages/') + a['name']
        lines += [f'# Filled in from {a["from"]} ({a["name"]} {a["version"]}). Its PKGBUILD, for the',
                  f'# source address and any patches: {where}']
    if lacking:
        lines.append(f'# No CRUX port yet (each needs one first): {" ".join(lacking)}')
    lines += ['', f'name={name}', f'version={version}', 'release=1',
              'source=(TODO: the release tarball, e.g. https://…/$name-$version.tar.gz)', '',
              'build() {', BUILDS[kind], '}', '']
    os.makedirs(target, exist_ok=True)
    with open(os.path.join(target, 'Pkgfile'), 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines))
    print(f'{target}/Pkgfile written ({kind} build{", from " + a["from"] if a else ""})')
    if lacking:
        print(f'  no CRUX port yet: {" ".join(lacking)}')
    return 0


def main(argv):
    if len(argv) < 1 or argv[0] in ('-h', '--help', 'help'):
        print(__doc__)
        return 0
    cmd, names = argv[0], argv[1:]
    if cmd == 'deps':
        return cmd_deps(names) if names else (print('deps: which packages?'), 2)[1]
    if cmd == 'check':
        return cmd_check(names)
    if cmd == 'explain':
        return cmd_explain(names)
    if cmd == 'new':
        return cmd_new(names[0], names[1]) if len(names) == 2 else (print('new: NAME PORTSDIR'), 2)[1]
    if cmd == 'arch':
        return cmd_arch(names) if names else (print('arch: which packages?'), 2)[1]
    print(f'metamelayer-deps: unknown command {cmd!r}', file=sys.stderr)
    return 2


if __name__ == '__main__':
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)   # quietly stop when piped into head
    sys.exit(main(sys.argv[1:]))
