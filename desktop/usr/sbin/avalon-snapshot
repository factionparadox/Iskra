#!/bin/sh
# avalon-snapshot: Btrfs snapshots of the system, and GRUB entries to start it as it was. As root.
#
#   avalon-snapshot take [--auto] [WHY]  a snapshot of the system (/ only: /home, /var/log and the
#                                        snapshots themselves are left out, so going back never
#                                        loses your files or the logs). --auto ones (metamelayer
#                                        takes one before each install, upgrade and removal) keep
#                                        the newest 10; ones you take yourself stay until forgotten
#   avalon-snapshot list                 the snapshots, newest first
#   avalon-snapshot rollback NAME        from the next start, the system is NAME again (what you
#                                        have now is kept as a snapshot, so it can be undone too)
#   avalon-snapshot forget NAME...       delete snapshots
#   avalon-snapshot grub                 bring the boot menu's "Avalon as it was" entries up to date
#   avalon-snapshot menu                 those entries, for GRUB (/etc/grub.d/41_avalon-snapshots)
#
# The disk: one Btrfs partition with the subvolumes @ (the system, mounted at /), @home,
# @log (/var/log) and @snapshots (/.snapshots). A snapshot is a copy of @ that shares everything
# that hasn't changed, so it's quick and takes little room until the system moves on.
set -e
SNAP=/.snapshots
KEEP=${AVALON_SNAPSHOTS_KEEP:-10}
CFG=/boot/grub/grub.cfg
MARK=/etc/grub.d/41_avalon-snapshots

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;35mavalon-snapshot:\033[0m %s\n' "$*" >&2; exit 1; }

usable()  { [ "$(findmnt -no FSTYPE /)" = btrfs ] && mountpoint -q $SNAP; }
running() { findmnt -no FSROOT / | sed 's|^/||'; }          # @, or @snapshots/NAME when started from one
on_main() { [ "$(running)" = @ ]; }
device()  { findmnt -no SOURCE / | sed 's/\[.*//'; }
slug()    { printf '%s' "$*" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' | tr -s '-' | sed 's/^-//; s/-$//' | cut -c1-48; }
label()   {   # 2026-11-06_214012-auto-before-install-fuzzel → 6 Nov 2026 21:40, before install fuzzel
	d=${1%%_*}; rest=${1#*_}; t=${rest%%-*}; why=${rest#*-}; why=${why#auto-}
	[ "$why" = "$rest" ] && why=
	when=$(date -d "$d" '+%-d %b %Y' 2>/dev/null || echo "$d")
	printf '%s %s:%s%s' "$when" "$(echo "$t" | cut -c1-2)" "$(echo "$t" | cut -c3-4)" "${why:+, $(echo "$why" | tr '-' ' ')}"
}
snapshots() { ls -1 $SNAP 2>/dev/null | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}' | sort -r; }
need_root() { [ "$(id -u)" = 0 ] || die "this needs root: sudo $0 $*"; }

menu() {   # GRUB entries, one per snapshot, newest first, under one submenu
	usable || return 0
	list=$(snapshots)
	[ -n "$list" ] || return 0
	uuid=$(blkid -s UUID -o value "$(device)")
	puuid=$(blkid -s PARTUUID -o value "$(device)")
	echo "submenu 'Avalon as it was (snapshots)' --class avalon {"
	for s in $list; do
		k=$(ls -1 "$SNAP/$s"/boot/vmlinuz-* 2>/dev/null | sort -V | tail -1)
		[ -n "$k" ] || continue
		cat <<EOF
	menuentry '$(label "$s")' --class avalon {
		insmod part_gpt
		insmod btrfs
		search --no-floppy --fs-uuid --set=root $uuid
		echo 'Starting Avalon as it was: $(label "$s")'
		linux /@snapshots/$s/boot/${k##*/} root=PARTUUID=$puuid rootfstype=btrfs rootflags=subvol=@snapshots/$s rootwait ro quiet
	}
EOF
	done
	echo "}"
}

put_menu() {   # write the snapshot entries into a grub.cfg: in place of the old ones, or at the end
	cfg=$1 tmp=$(mktemp) entries=$(mktemp)
	menu > "$entries"
	if grep -q "^### BEGIN $MARK ###" "$cfg"; then
		awk -v f="$entries" -v b="### BEGIN $MARK ###" -v e="### END $MARK ###" '
			$0 == b { print; while ((getline l < f) > 0) print l; skip = 1; next }
			$0 == e { skip = 0 }
			!skip' "$cfg" > "$tmp"
	else
		{ cat "$cfg"; echo; echo "### BEGIN $MARK ###"; cat "$entries"; echo "### END $MARK ###"; } > "$tmp"
	fi
	# only a complete result replaces the menu (never an empty or cut-off one)
	if grep -q "^### END $MARK ###" "$tmp" && [ "$(wc -l < "$tmp")" -ge "$(wc -l < "$cfg")" ] || [ ! -s "$entries" ]; then
		grep -q "^### END $MARK ###" "$tmp" && cat "$tmp" > "$cfg"
	fi
	rm -f "$tmp" "$entries"
}

grub() {
	on_main || return 0          # started from a snapshot: its /boot isn't the one GRUB reads
	[ -f $CFG ] || return 0
	if grep -q "^### BEGIN $MARK ###" $CFG; then put_menu $CFG
	elif [ -x $MARK ]; then grub-mkconfig -o $CFG >/dev/null 2>&1 || echo "    (grub-mkconfig failed: the boot menu is as it was)"
	fi
}

take() {
	auto=; [ "${1:-}" = --auto ] && { auto=1; shift; }
	if ! usable; then
		[ -n "$auto" ] && return 0
		die "snapshots need / on Btrfs with $SNAP mounted (Avalon's installer sets that up)"
	fi
	if ! on_main; then
		case $(running) in
			*-before-a-rollback) echo "    (no snapshot: a rollback is waiting for a restart)" ;;
			*) echo "    (no snapshot: you started from the snapshot $(running | sed 's|^@snapshots/||'); sudo metamelayer rollback NAME keeps it)" ;;
		esac
		return 0
	fi
	why=$(slug "${*:-by hand}")
	name=$(date +%Y-%m-%d_%H%M%S)${auto:+-auto}${why:+-$why}
	while [ -e "$SNAP/$name" ]; do sleep 1; name=$(date +%Y-%m-%d_%H%M%S)${auto:+-auto}${why:+-$why}; done
	btrfs subvolume snapshot / "$SNAP/$name" >/dev/null
	say "Snapshot: $(label "$name")   (to go back: sudo metamelayer rollback $name)"
	if [ -n "$auto" ]; then       # the newest $KEEP automatic ones stay
		snapshots | grep -- '_[0-9]\{6\}-auto' | tail -n +$((KEEP + 1)) | while read -r old; do
			btrfs subvolume delete "$SNAP/$old" >/dev/null && echo "    (an old automatic snapshot went: $(label "$old"))"
		done
	fi
	grub
}

rollback() {
	n=${1:-}; [ -n "$n" ] || die "rollback to which? (avalon-snapshot list)"
	[ -d "$SNAP/$n" ] || die "no snapshot called $n (avalon-snapshot list)"
	usable || die "snapshots need / on Btrfs with $SNAP mounted"
	top=$(mktemp -d)
	mount -o subvolid=5 "$(device)" "$top"
	trap 'umount "$top" 2>/dev/null; rmdir "$top" 2>/dev/null' EXIT
	[ -d "$top/@" ] && [ -d "$top/@snapshots/$n" ] || die "the disk isn't laid out as Avalon's (@ and @snapshots)"
	keep=$(date +%Y-%m-%d_%H%M%S)-before-a-rollback
	mv "$top/@" "$top/@snapshots/$keep"
	btrfs subvolume snapshot "$top/@snapshots/$n" "$top/@" >/dev/null
	# the boot menu GRUB will read is the one inside the new @: give it today's snapshot entries
	[ -f "$top/@/boot/grub/grub.cfg" ] && put_menu "$top/@/boot/grub/grub.cfg"
	say "From the next start, Avalon is as it was on $(label "$n")"
	echo "    What you had until now is kept as the snapshot $keep,"
	echo "    so this can be undone the same way: sudo metamelayer rollback $keep"
	echo "    Restart when you're ready."
}

forget() {
	[ $# -gt 0 ] || die "forget which? (avalon-snapshot list)"
	for n in "$@"; do
		[ -d "$SNAP/$n" ] || { echo "    no snapshot called $n"; continue; }
		[ "$(running)" = "@snapshots/$n" ] && { echo "    $n is the one running now: start Avalon normally first"; continue; }
		btrfs subvolume delete "$SNAP/$n" >/dev/null && echo "    forgot $(label "$n")"
	done
	grub
}

list() {
	usable || die "snapshots need / on Btrfs with $SNAP mounted"
	on_main || say "Running now: the snapshot $(running | sed 's|^@snapshots/||') (sudo metamelayer rollback NAME keeps it)"
	l=$(snapshots)
	[ -n "$l" ] || { echo "    no snapshots yet"; return 0; }
	for n in $l; do printf '  %-60s %s\n' "$n" "$(label "$n")"; done
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
	take)     need_root take; take "$@" ;;
	list|ls)  list ;;
	rollback) need_root rollback; rollback "$@" ;;
	forget)   need_root forget; forget "$@" ;;
	grub)     need_root grub; grub ;;
	menu)     menu ;;
	*)        sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
