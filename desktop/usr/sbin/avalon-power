#!/bin/sh
# /usr/sbin/avalon-power: suspend, restart, power off, or set the battery charge limit (as root; the Garden System runs it
# through sudo, which /etc/sudoers.d/avalon allows for the wheel group without a password).
case $1 in
  suspend) sync; echo mem > /sys/power/state ;;
  reboot)  exec /sbin/shutdown -r now ;;
  off)     exec /sbin/shutdown -h now ;;
  charge-limit)   # stop charging at N% (50-100), kept in /etc/avalon/charge-limit for every boot
           n=$2
           case $n in ''|*[!0-9]*) echo "charge-limit needs a number" >&2; exit 2 ;; esac
           [ "$n" -ge 50 ] && [ "$n" -le 100 ] || { echo "charge-limit: 50-100" >&2; exit 2; }
           found=
           for b in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
             [ -w "$b" ] && echo "$n" > "$b" && found=1
           done
           [ -n "$found" ] || { echo "this battery has no charge limit" >&2; exit 1; }
           mkdir -p /etc/avalon && echo "$n" > /etc/avalon/charge-limit ;;
  *)       echo "usage: avalon-power suspend|reboot|off|charge-limit N" >&2; exit 2 ;;
esac
