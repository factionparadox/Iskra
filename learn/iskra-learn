def topics():
    root = DOC_ROOT / "topics"
    if not root.is_dir():
        return {}
    return {p.stem: p for p in sorted(root.glob("*.md"))
            if p.is_file() and TOPIC_NAME.fullmatch(p.stem)}


def read_topic(name):
    if not TOPIC_NAME.fullmatch(name):
        return None
    path = topics().get(name)
    return path.read_text(encoding="utf-8") if path else None


def learn(name=None):
    if name is None:
        available = topics()
        if not available:
            print("Iskra offline lessons are missing.", file=sys.stderr)
            return 2
        print("ISKRA LEARN — understand, inspect, adapt\n")
        for key, path in available.items():
            heading = next((line[2:] for line in path.read_text(encoding="utf-8").splitlines()
                            if line.startswith("# ")), key)
            print(f"  {key:<16} {heading}")
        print("\nRead: iskra-learn learn packages")
        print("Browse: iskra-learn browse")
        print("The wiki (Slackware in depth): iskra-learn wiki ; search: iskra-learn search WORD")
        print("Explain without running: iskra-learn explain \"sudo sparkpkg install gimp\"")
        return 0
    page = read_topic(name)
    if page is None:
        print("Unknown lesson. List lessons with iskra-learn learn.",
              file=sys.stderr)
        return 2
    print(page)
    return 0


def wiki_pages():
    root = DOC_ROOT / "wiki"
    if not root.is_dir():
        return {}
    return {p.stem: p for p in sorted(root.glob("*.md"))
            if p.is_file() and TOPIC_NAME.fullmatch(p.stem)}


def show(text):
    """Long pages go through less in a terminal; otherwise print them."""
    pager = shutil.which("less")
    if pager and sys.stdout.isatty() and text.count("\n") > 40:
        subprocess.run([pager, "-R"], input=text, text=True, check=False)
    else:
        print(text)


def wiki(name=None):
    pages = wiki_pages()
    if not pages:
        print("The Iskra wiki is missing (iskra-learn package).", file=sys.stderr)
        return 2
    if name is None:
        name = "index"
    name = WIKI_FOR.get(name, name)
    if not TOPIC_NAME.fullmatch(name) or name not in pages:
        print(f"No wiki page '{name}'. The index: iskra-learn wiki ; "
              f"search: iskra-learn search {name}", file=sys.stderr)
        return 2
    show(pages[name].read_text(encoding="utf-8"))
    return 0


def search(words):
    """Every line in the lessons and the wiki containing all the words (any case)."""
    words = [w.lower() for w in words if w.strip()]
    if not words:
        print("Usage: iskra-learn search WORD [WORD...]", file=sys.stderr)
        return 2
    found = 0
    for kind, pages in (("wiki", wiki_pages()), ("learn", topics())):
        for name, path in pages.items():
            for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
                if all(w in line.lower() for w in words):
                    print(f"{kind} {name}:{number}: {line.strip()}")
                    found += 1
    if not found:
        print("Nothing found. The wiki's index: iskra-learn wiki")
        return 1
    print(f"\nRead a page: iskra-learn wiki NAME  (or: iskra-learn learn NAME)")
    return 0


def browse():
    while True:
        available = list(topics())
        if not available:
            return learn()
        print("\nISKRA LEARN — offline lessons\n")
        for i, item in enumerate(available, 1):
            print(f"  {i:2}. {item}")
        print("   q. Quit")
        try:
            response = input("Choose a lesson: ").strip()
        except (EOFError, KeyboardInterrupt):
            return 0
        if response.lower() in ("", "q", "quit", "exit"):
            return 0
        if not response.isdigit() or int(response) not in range(1, len(available) + 1):
            print("Enter a listed number.")
            continue
        print("\n" + (read_topic(available[int(response) - 1]) or "Missing lesson"))
        try:
            input("\nEnter to return to the lessons...")
        except (EOFError, KeyboardInterrupt):
            return 0


def rc_script(tokens):
    """The service script a command line is about: /etc/rc.d/NAME run directly, or given to
    chmod (which switches it on or off at boot). None otherwise."""
    if tokens[0].startswith(str(RC_D) + "/"):
        return tokens[0]
    if Path(tokens[0]).name == "chmod":
        return next((t for t in tokens[1:] if t.startswith(str(RC_D) + "/")), None)
    return None


def lookup_key(tokens):
    """The table keys for a command line, most specific first: "sparkpkg install",
    "upgradepkg --install-new", then the command's own name. A service script (/etc/rc.d/NAME),
    run or given to chmod, is "rc.d"."""
    if rc_script(tokens):
        return ["rc.d"]
    command = Path(tokens[0]).name.lower()
    words = [t for t in tokens[1:] if not t.startswith("-")]
    flags = [t for t in tokens[1:] if t.startswith("-")]
    keys = []
    if len(words) >= 2:
        keys.append(f"{command} {words[0]} {words[1]}")
    if words:
        keys.append(f"{command} {words[0]}")
    keys += [f"{command} {flag}" for flag in flags]
    keys.append(command)
    return keys


def first(table, keys):
    return next((table[k] for k in keys if k in table), None)


def executable(path):
    return Path(path).is_file() and os.access(path, os.X_OK)


def iskra_services():
    """The SERVICES list at the top of /etc/rc.d/rc.iskra, in order (empty if there is none)."""
    try:
        text = RC_ISKRA.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    found = re.search(r'^SERVICES="([^"]*)"', text, re.M)
    return found.group(1).split() if found else []


