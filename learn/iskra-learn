def notes(command, tokens):
    """What a command would change, in a line or two (read from the command line only)."""
    words = [t for t in tokens[1:] if not t.startswith("-")]
    flags = [t for t in tokens[1:] if t.startswith("-")]
    sub = words[0] if words else ""
    out = []
    if (command == "sparkpkg" and sub in ("upgrade", "up")) or (
            command == "iskra-update" and "--dry" not in flags) or (
            command == "slpkg" and sub == "upgrade" and "--dry-run" not in flags):
        out.append("This fetches every repository's latest lists, then replaces each installed "
                   "package that has a\nnewer version: ready-made packages, so it takes minutes. "
                   "Anything sparkpkg built from an\nArch or AUR recipe is rebuilt if its recipe "
                   "is newer. Settings files you have edited are kept;\nthe new ones arrive "
                   "beside them as NAME.new. sudo sparkpkg undo takes the last change back.")
    if command == "iskra-update" and "--dry" in flags:
        out.append("With --dry it only fetches the lists (slpkg update) and shows what would "
                   "change; nothing is\ninstalled.")
    if (command == "sparkpkg" and sub in ("sync", "update")) or (
            command == "slpkg" and sub == "update"):
        out.append("This only fetches the repositories' package lists; nothing is installed "
                   "or upgraded.")
    if command == "sparkpkg" and sub in ("install", "i", "add"):
        out.append("sparkpkg takes each package from the first repository, in Iskra's order, "
                   "that has it, with\nwhat it needs; if none has it, it builds Arch's or the "
                   "AUR's recipe into a Slackware\npackage, and shows you the plan first.")
    if command == "sparkpkg" and sub == "aur":
        out.append("AUR recipes can be written by anyone: sparkpkg offers to show the PKGBUILD "
                   "before building.\nIt builds as an ordinary user, never as root.")
    if command == "upgradepkg":
        out.append("upgradepkg replaces the installed package of the same name with this file"
                   + (", or installs it if\nthere is none" if "--install-new" in flags else "")
                   + ". It doesn't compare versions, so an older file goes back\nto that "
                   "version. Settings files you have edited are kept; new ones arrive as NAME.new.")
    if command == "installpkg":
        out.append("installpkg installs the file as it is: nothing it needs is checked or "
                   "fetched (sparkpkg\ninstall does that).")
    script = rc_script(tokens)
    if script:
        name = Path(script).name
        own = name in OWN_SCRIPTS
        if Path(tokens[0]).name == "chmod":
            on = any("+x" in t for t in tokens[1:])
            out.append(f"This changes whether {name} starts at boot: from the next boot it "
                       + ("will start" if on else "won't start")
                       + (".\nrc.iskra starts it, from rc.local, if it is executable." if own else
                          ".\nrc.M starts it, if it is executable."))
        else:
            action = words[0] if words else "start|stop|restart|status"
            out.append(f"This runs the {name} service script with '{action}' now; it lasts "
                       "until the next boot.\nAt boot it starts only if the script is "
                       "executable"
                       + (f" ({name} is not, now)." if Path(script).exists()
                          and not executable(script) else ".")
                       + (" rc.iskra starts it, from rc.local." if own else ""))
    if command in OLD_COMMANDS:
        out.append(f"Iskra is Slackware now: there is no {command} here. What does its job: "
                   f"{OLD_COMMANDS[command]}.\n(iskra-learn wiki from-arch has the rest.)")
    destructive = command in ("mkfs.xfs", "mkfs.vfat", "mkfs.fat", "mkfs.exfat", "wipefs",
                              "sfdisk", "sgdisk", "xfs_repair", "dd", "removepkg") or (
        command in ("sparkpkg", "slpkg") and sub in ("remove", "rm", "del"))
    if destructive:
        out.append("CAUTION: this command can change or destroy system state"
                   + (" (a removed package comes back\nwith sudo sparkpkg undo, or by "
                      "installing it again)."
                      if command in ("removepkg", "sparkpkg", "slpkg") else "."))
    return out


def explain(parts):
    if not parts:
        print('Usage: iskra-learn explain "sudo sparkpkg install gimp"', file=sys.stderr)
        return 2
    command_line = " ".join(parts)
    try:
        tokens = shlex.split(command_line)
    except ValueError as error:
        print("Invalid command: " + str(error), file=sys.stderr)
        return 2
    if not tokens:
        return 2
    # sudo (run as root), sudo -E, sh (run a script) and 9 (the Plan 9 version) only wrap the
    # real command
    while len(tokens) > 1 and (Path(tokens[0]).name in ("sudo", "9", "sh") or
                               (tokens[0].startswith("-") and len(tokens[0]) <= 3)):
        tokens = tokens[1:]
    keys = lookup_key(tokens)
    command = Path(tokens[0]).name.lower() if keys == ["rc.d"] else keys[-1]
    print("Command: " + command_line)
    print("READ ONLY: This command was NOT executed.\n")
    lesson_name = first(ALIASES, keys)
    lesson = read_topic(lesson_name) if lesson_name else None
    print(lesson or "No dedicated lesson for this command. Read its manual page.")
    for note in notes(command, tokens):
        print("\n" + note)
    wiki_page = first(WIKI_FOR, keys)
    if wiki_page:
        print("\nIn depth: iskra-learn wiki " + wiki_page)
    print("Reference: " + (first(MANUALS, keys) or ("iskra-learn wiki from-arch"
                                                     if command in OLD_COMMANDS
                                                     else "man " + command)))
    return 0


def read_only(argv, timeout=4):
    if not shutil.which(argv[0]):
        return "unavailable: " + argv[0]
    try:
        result = subprocess.run(argv, capture_output=True, text=True,
                                check=False, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return "not available"
    if result.returncode != 0:
        return "unavailable or inactive"
    return result.stdout.strip().split("\n")[0][:190] or "no output"


def battery():
    for bat in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        try:
            return (f"{bat.name} {(bat / 'capacity').read_text().strip()} % "
                    f"{(bat / 'status').read_text().strip().lower()}")
        except OSError:
            continue
    return "no battery reported"


def first_line(path):
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace").split("\n")[0].strip()
    except OSError:
        return None


def slackware_version():
    """Slackware's own answer (/etc/slackware-version: "Slackware 15.0+" is -current), with the
    kernel package's version."""
    version = first_line("/etc/slackware-version")
    if not version:
        return "not Slackware (no /etc/slackware-version)"
    if version.endswith("+"):
        version += " (-current)"
    kernel = sorted(p.name for p in PKG_DB.glob("kernel-generic-*")) if PKG_DB.is_dir() else []
    return version + (f", kernel-generic {kernel[-1].split('-')[2]}" if kernel else "")


def packages():
    """How many packages are installed: one file each in /var/lib/pkgtools/packages, and how
    many of them are Iskra's own, or built by sparkpkg from a recipe."""
    try:
        names = [p.name for p in PKG_DB.iterdir()]
    except OSError:
        return "unknown (no " + str(PKG_DB) + ")"
    iskra = sum(1 for n in names if n.endswith("_iskra"))
    recipes = sum(1 for n in names if n.endswith(("_aur", "_arch")))
    return (f"{len(names)} installed ({iskra} Iskra's own, {recipes} built from Arch/AUR "
            f"recipes; {PKG_DB})")


def last_change():
    """When packages last changed: slpkg's history, else the newest entry of the package list."""
    for path in (SLPKG_HISTORY, PKG_DB):
        try:
            when = path.stat().st_mtime
        except OSError:
            continue
        return (time.strftime("%Y-%m-%d %H:%M", time.localtime(when))
                + ("  (sparkpkg history)" if path == SLPKG_HISTORY else ""))
    return "unknown"


def repositories():
    """The PRIORITY list under [ALL_REPOS] in /etc/slpkg/repositories.toml, in order."""
    try:
        text = SLPKG_REPOS.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return "unknown (no " + str(SLPKG_REPOS) + ")"
    section = re.search(r"^\[ALL_REPOS\]\s*$(.*?)(?=^\[|\Z)", text, re.M | re.S)
    found = section and re.search(r"^PRIORITY\s*=\s*\[([^\]]*)\]", section.group(1), re.M)
    if not found:
        return "no PRIORITY list in " + str(SLPKG_REPOS)
    return " ".join(re.findall(r'"([^"]+)"', found.group(1))) or "none listed"


def new_files():
    """Settings files that arrived as .new beside an edited copy (readable folders only)."""
    found = []
    for folder, _, files in os.walk("/etc", onerror=lambda error: None):
        found += [os.path.join(folder, f) for f in files if f.endswith(".new")]
    if not found:
        return "none"
    shown = " ".join(sorted(found)[:3]) + (" ..." if len(found) > 3 else "")
    return f"{len(found)}: {shown}"


def hibernation():
    cmdline = first_line("/proc/cmdline") or ""
    try:
        swaps = Path("/proc/swaps").read_text().splitlines()[1:]
    except OSError:
        swaps = []
    partition = any(len(l.split()) > 1 and l.split()[1] == "partition" for l in swaps)
    if "resume=" in cmdline and partition:
        return "ready (resume= on the kernel line, a swap partition)"
    if partition:
        return "no resume= on the kernel line (/etc/default/grub)"
    return "no swap partition to hibernate into"


def process(name):
    """Whether a process of that name runs, looked at without root."""
    if not shutil.which("pgrep"):
        return "unknown"
    try:
        result = subprocess.run(["pgrep", "-x", name], capture_output=True, text=True,
                                check=False, timeout=4)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    pids = result.stdout.split()
    return f"running ({name}, pid {pids[0]})" if pids else f"not running ({name})"


def script_status(script):
    """A one-off service's own status line (as root only)."""
    try:
        result = subprocess.run([script, "status"], capture_output=True, text=True,
                                check=False, timeout=6, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return "status not available"
    lines = [l.strip() for l in (result.stdout + result.stderr).splitlines() if l.strip()]
    return lines[0][:100] if lines else "no status output"


def iskra_service(name):
    """One of rc.iskra's services: installed? on at boot? running?"""
    path, proc = ISKRA_SERVICE.get(name, (None, None))
    if path is None:
        return "not known to iskra-learn (read /etc/rc.d/rc.iskra)"
    if not Path(path).exists():
        return "not installed"
    if path.startswith(str(RC_D)) and not executable(path):
        return f"off at boot ({path} is not executable)"
    if proc:
        return process(proc)
    if os.geteuid() == 0:
        return script_status(path)
    return "runs once at boot (sudo iskra-learn doctor shows its status)"


def slackware_service(script, proc):
    path = RC_D / script
    if not path.exists():
        return "not installed"
    boot = "on at boot" if executable(path) else "off at boot"
    return f"{boot:<12} {process(proc)}"


def doctor():
    print("ISKRA SYSTEM MAP: observations only; nothing is changed or sent anywhere.\n")
    values = (
        ("Init (PID 1)", lambda: first_line("/proc/1/comm") or "unknown"),
        ("Kernel", lambda: read_only(["uname", "-r"])),
        ("System", slackware_version),
        ("Iskra", lambda: first_line("/usr/share/iskra/version") or "not installed"),
        ("Packages", packages),
        ("Last change", last_change),
        ("Repositories", repositories),
        ("Settings (.new)", new_files),
        ("Root filesystem", lambda: read_only(["findmnt", "-n", "-o", "SOURCE,FSTYPE,OPTIONS",
                                               "--target", "/"])),
        ("Swap", lambda: read_only(["swapon", "--show=NAME,TYPE,SIZE", "--noheadings"])),
        ("Hibernation", hibernation),
        ("Power profile", lambda: first_line("/sys/firmware/acpi/platform_profile")
                                  or "not reported"),
    )
    for label, get in values:
        print(f"{label:<17} {get()}")
    print(f"{'Battery':<17} {battery()}")
    print(f"{'Display':<17} {os.environ.get('DISPLAY', 'not in X')}  (window manager: ratpoison)")
    print("\nSlackware's services (rc.M starts each one whose script is executable):")
    for script, proc in SLACKWARE_SERVICES:
        print(f"  {script:<19} {slackware_service(script, proc)}")
    names = iskra_services()
    if names:
        print(f"\nIskra's services ({RC_ISKRA}, started from rc.local):")
        for name in names:
            print(f"  {name:<19} {iskra_service(name)}")
    else:
        print(f"\nIskra's services: no SERVICES list found in {RC_ISKRA}")
    print("\nWhat would update:  iskra-update --dry")
    print("Take back the last install, upgrade or removal:  sudo sparkpkg undo")
    print("\nWhat each line means: iskra-learn learn architecture")
    print("Sources and manuals:  iskra-learn sources")
    return 0


def open_reference(target):
    try:
        return 0 if webbrowser.open(target) else 2
    except (OSError, webbrowser.Error):
        return 2


def handbook():
    """The Slackware book, offline, in less (iskra-handbook does the same in its own window)."""
    if not HANDBOOK.is_file():
        print(f"The Slackware book is not at {HANDBOOK} yet. Fetch it (once, with the "
              "internet): sudo iskra-handbook update")
        print("Online: " + BOOK_WEB)
        return 2
    pager = shutil.which("less")
    if pager and sys.stdin.isatty() and sys.stdout.isatty():
        return subprocess.run([pager, str(HANDBOOK)], check=False).returncode
    print(f"The Slackware book, offline: less {HANDBOOK}  (or iskra-handbook)")
    print("Beside this wiki, in Midnight Commander: iskra-handbook mc")
    print("Online: " + BOOK_WEB)
    return 0


def sources():
    print("ISKRA REFERENCE LIBRARY\n")
    for name, address in SOURCES:
        print(f"{name}\n  {address}")
    return 0


def manual(name):
    if not MAN_NAME.fullmatch(name):
        print("Invalid manual name.", file=sys.stderr)
        return 2
    if not shutil.which("man"):
        print("Manual viewer unavailable; read the Slackware book: iskra-handbook",
              file=sys.stderr)
        return 2
    return subprocess.run(["man", "--", name], check=False).returncode


def main(argv=None):
    p = argparse.ArgumentParser(prog="iskra-learn",
                                description="Read-only lessons and inspection for Iskra")
    sub = p.add_subparsers(dest="action")
    ln = sub.add_parser("learn", help="list or read an offline chapter")
    ln.add_argument("topic", nargs="?")
    ex = sub.add_parser("explain", help="explain without executing")
    ex.add_argument("command", nargs=argparse.REMAINDER)
    sub.add_parser("browse", help="browse offline chapters interactively")
    wk = sub.add_parser("wiki", help="the Iskra wiki: Slackware explained, page by page")
    wk.add_argument("page", nargs="?")
    se = sub.add_parser("search", help="search the lessons and the wiki")
    se.add_argument("words", nargs="+")
    sub.add_parser("doctor", help="show read-only system state")
    sub.add_parser("handbook", help="open the Slackware book, offline")
    sub.add_parser("sources", help="show authoritative reference links")
    ma = sub.add_parser("manual", help="open installed man page")
    ma.add_argument("name")
    args = p.parse_args(argv)
    if args.action in (None, "learn"):
        return learn(getattr(args, "topic", None))
    if args.action == "browse":
        return browse()
    if args.action == "wiki":
        return wiki(args.page)
    if args.action == "search":
        return search(args.words)
    if args.action == "doctor":
        return doctor()
    if args.action == "explain":
        return explain(args.command)
    if args.action == "handbook":
        return handbook()
    if args.action == "sources":
        return sources()
    if args.action == "manual":
        return manual(args.name)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:                   # piped into head, or a pager that quit early
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
